/* 组件宿主节点撑满 swiper-item，否则内部 scroll-view 的 height:100% 无参照 */
:host {
  display: block;
  height: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

/* 滚动容器：swiper-item 内必须显式指定滚动容器 */
.page-scroll {
  width: 100%;
  height: 100%;
}

.page {
  /* scroll-view 内百分比高度无参照，用 vh 让空态仍能撑满居中 */
  min-height: 100vh;
  padding: 24rpx;
  /* 悬浮胶囊底栏：胶囊高 108rpx + 底部偏移 20rpx + 安全区 + 呼吸留白 */
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.user-card {
  display: flex;
  align-items: center;
  background: var(--color-dark-card);
  border-radius: var(--radius-card);
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}
.user-avatar {
  font-size: 80rpx;
  margin-right: 24rpx;
}
.user-info {
  flex: 1;
}
.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-card);
}
.card {
  margin-bottom: 24rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 28rpx;
  color: var(--color-text-1);
}
.row-arrow {
  font-size: 40rpx;
  color: var(--color-text-3);
}
.version {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-3);
}
