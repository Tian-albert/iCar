/* 组件宿主节点撑满父级，否则内部 swiper 的 height:100% 无参照 */
:host {
  display: block;
  height: 100%;
  /* 关键：不给页面留横向平移空间。
     iOS WebView 里，页面一旦有横向可滚动的溢出，整页（含 fixed 底栏）
     会跟着手指平移 —— 这就是「整条底栏跟着滑动」的根因。 */
  max-width: 100vw;
  overflow-x: hidden;
}

.host-swiper {
  width: 100%;
  height: 100%;
}

/*
 * swiper-item 内需要能纵向滚动。
 * swiper-item 本身不是滚动容器，内容超出时由内部组件的 scroll-view 负责。
 */
.host-swiper-item {
  height: 100%;
  overflow: hidden;
}
