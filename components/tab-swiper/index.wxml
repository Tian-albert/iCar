<!--
  三个 tab 的内容容器：swiper 承载，页面内容真正跟手横向滑动。

  渲染策略：只渲染**当前 tab 及其相邻**的页面（keep0/keep1/keep2）。
  - 如果只渲染当前页，跨页滑动时目标页是空白，滑到位才「啪」一下出现
  - 如果全渲染，概览页的 canvas 环图会常驻抢节点
  只保留相邻页，滑动时目标页已经在了，衔接顺畅；内存也只多占一页。
-->
<swiper
  class="host-swiper"
  current="{{current}}"
  bindtouchstart="onUserScrollStart"
  bindchange="onChange"
  bindtransition="onTransition"
  bindanimationfinish="onAnimationFinish">
  <swiper-item class="host-swiper-item">
    <tab-overview wx:if="{{keep0}}" index="0" bind:ready="onChildReady" />
  </swiper-item>
  <swiper-item class="host-swiper-item">
    <tab-vehicles wx:if="{{keep1}}" index="1" bind:ready="onChildReady" />
  </swiper-item>
  <swiper-item class="host-swiper-item">
    <tab-profile wx:if="{{keep2}}" index="2" bind:ready="onChildReady" />
  </swiper-item>
</swiper>
