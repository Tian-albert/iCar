/* 组件宿主节点撑满 swiper-item，否则内部 scroll-view 的 height:100% 无参照 */
:host {
  display: block;
  height: 100%;
}

/* 滚动容器：swiper-item 内必须显式指定滚动容器 */
.page-scroll {
  width: 100%;
  height: 100%;
}

.page {
  /* scroll-view 内百分比高度无参照，用 vh 让空态仍能撑满居中 */
  min-height: 100vh;
  padding: 24rpx;
  /* 悬浮胶囊底栏：胶囊高 108rpx + 底部偏移 20rpx + 安全区 + 呼吸留白 */
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- A 全局指标条 ---------- */
.head-line {
  padding: 8rpx 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.metrics {
  display: flex;
  padding: 28rpx 8rpx;
  background: var(--color-card);
  border-radius: var(--radius-card);
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}
.m-cell {
  flex: 1;
  position: relative;
  text-align: center;
}
.m-cell + .m-cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: var(--color-divider);
}
.m-val {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.m-val-sm {
  font-size: 32rpx;
}
.m-lbl {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.m-warn .m-val {
  color: var(--color-danger);
}

/* ---------- E 漏记提醒（弱提示） ---------- */
.stale {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 8rpx 0;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.stale-ic {
  opacity: 0.7;
}

/* ---------- 区块 ---------- */
.sec-title {
  margin: 32rpx 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
/* .card 复用 app.wxss 全局类（内边距与阴影已统一，勿在页内重定义） */

/* ---------- B 保养总览 ---------- */
.mnt-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.mnt-row:last-child {
  border-bottom: none;
}
.mnt-car {
  width: 112rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mnt-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mnt-remain {
  flex-shrink: 0;
  font-size: 24rpx;
  white-space: nowrap;
}
.mnt-remain.bad {
  color: var(--color-danger);
  font-weight: 500;
}
.mnt-remain.warn {
  color: var(--color-warning);
}
.go {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
  color: var(--color-text-3);
}
/* 不加 border-top：上一行 .mnt-row 的 border-bottom 已充当分隔线，
   否则两条 1rpx 相邻会叠成 2rpx 的粗线 */
.mnt-all {
  display: block;
  padding-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-primary);
}
.mnt-empty {
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-3);
}

/* ---------- C 今年花费 · 按车 ---------- */
.cost-wrap {
  display: flex;
  align-items: center;
  gap: 40rpx;
}
/* 逻辑尺寸 104px；实际绘制由 canvas.width/height 按 dpr 决定 */
.donut-canvas {
  width: 208rpx;
  height: 208rpx;
  flex-shrink: 0;
}
/* 无支出时收起画布（节点保留以便后续绘制），把空间让给空态文案 */
.donut-canvas.donut-idle {
  width: 0;
  height: 0;
  opacity: 0;
}
.cost-empty {
  flex: 1;
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-3);
  line-height: 1.6;
}
.legend {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.lg-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.lg-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lg-val {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
  text-align: right;
}
.lg-pct {
  width: 60rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-3);
  text-align: right;
}

/* ---------- D 最近记录 ---------- */
.rec-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.rec-row:last-child {
  border-bottom: none;
}
.rec-date {
  width: 84rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.rec-car {
  width: 108rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rec-type {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-1);
}
.rec-amt {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
