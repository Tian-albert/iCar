<view class="picker-mask" wx:if="{{show}}" bindtap="onClose">
  <!-- 面板本身只用于阻止冒泡，不能加 hover-class：按住空白处整块弹层会闪成半透明 -->
  <view class="picker-panel" catchtap="noop">
    <view class="picker-title">选择图标</view>

    <!-- 分栏：用普通 view 而非 scroll-view。
         两字标签后总宽足够，不需要滚动；scroll-view 的 overflow:hidden
         会裁掉略高的气泡，enable-flex 下横向滑动也不可靠。 -->
    <view class="tab-bar">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{item.key === activeKey ? 'tab-on' : ''}}"
        hover-class="hover-dim"
        data-key="{{item.key}}"
        bindtap="onTab">{{item.label}}</view>
    </view>

    <!-- 图标区：固定高度（正好两行），数量多时上下滚动。
         固定高度是为了切分栏时面板不上下跳动。 -->
    <scroll-view class="icon-scroll" scroll-y show-scrollbar="{{false}}">
      <block wx:if="{{isCustomTab}}">
        <view wx:if="{{customIcons.length === 0}}" class="custom-empty">
          <view class="custom-empty-title">还没有上传过图标</view>
          <view class="custom-empty-desc">点下方「＋ 自定义图标」上传，会自动裁成正方形</view>
        </view>
        <view wx:else class="icon-grid">
          <image
            wx:for="{{customIcons}}"
            wx:key="*this"
            class="icon-img-item"
            src="{{item}}"
            mode="aspectFill"
            data-icon="{{item}}"
            bindtap="onSelect"
            bindlongpress="onLongPressCustom" />
        </view>
      </block>

      <view wx:else class="icon-grid">
        <view
          hover-class="hover-dim"
          wx:for="{{icons}}"
          wx:key="*this"
          class="icon-item"
          data-icon="{{item}}"
          bindtap="onSelect">{{item}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{isCustomTab && customIcons.length > 0}}" class="longpress-hint">长按图标可删除</view>

    <view hover-class="hover-dim" class="custom-btn" bindtap="onCustom">＋ 自定义图标（上传图片）</view>
    <view class="custom-hint">任意尺寸图片都会裁成正方形，图标更清晰</view>
    <view hover-class="hover-dim" class="close-btn" bindtap="onClose">取消</view>
  </view>
</view>
