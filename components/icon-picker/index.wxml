<view class="picker-mask" wx:if="{{show}}" bindtap="onClose">
  <!-- 面板本身只用于阻止冒泡，不能加 hover-class：按住空白处整块弹层会闪成半透明 -->
  <view class="picker-panel" catchtap="noop">
    <view class="picker-title">选择图标</view>

    <!-- 分栏：用普通 view 而非 scroll-view。
         5 个分栏收窄内边距后总宽 632rpx < 可用 686rpx，本来就不需要滚动；
         而 scroll-view 的 overflow:hidden 会把略高的气泡顶部裁掉，
         横向滑动在 enable-flex 下也不可靠。wrap 仅作极端字号下的兜底。 -->
    <view class="tab-bar">
      <view
        wx:for="{{groups}}"
        wx:key="key"
        class="tab {{item.key === activeKey ? 'tab-on' : ''}}"
        hover-class="hover-dim"
        data-key="{{item.key}}"
        bindtap="onTab">{{item.label}}</view>
    </view>

    <!-- 当前分栏的图标 -->
    <scroll-view class="icon-scroll" scroll-y show-scrollbar="{{false}}">
      <view class="icon-grid">
        <view
          hover-class="hover-dim"
          wx:for="{{icons}}"
          wx:key="*this"
          class="icon-item"
          data-icon="{{item}}"
          bindtap="onSelect">{{item}}</view>
      </view>
    </scroll-view>

    <view hover-class="hover-dim" class="custom-btn" bindtap="onCustom">＋ 自定义图标（上传图片）</view>
    <view class="custom-hint">任意尺寸图片都会裁成正方形，图标更清晰</view>
    <view hover-class="hover-dim" class="close-btn" bindtap="onClose">取消</view>
  </view>
</view>
