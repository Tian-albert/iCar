.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.picker-panel {
  width: 100%;
  background: var(--color-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 图标变多后，面板不能无限长，否则小屏会顶出屏幕 */
  max-height: 84vh;
  display: flex;
  flex-direction: column;
}
.picker-title {
  flex-shrink: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

/* 分栏
   1) 不用 scroll-view：它的 overflow:hidden 会把比容器高的气泡顶部裁掉，
      enable-flex 下横向滑动也不可靠。两字标签后本来就不需要滚动。
   2) wrap 仅作兜底：个别机型 CJK 字宽略大于字号时自动换行，不溢出。
   3) 定高 + flex 居中：文字位置不依赖字体默认行高，也不会被父容器 stretch。 */
.tab-bar {
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 24rpx;
}
.tab {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  /* line-height:1 配合上面的 flex 居中，文字才真正居中 */
  line-height: 1;
  padding: 0 20rpx;
  margin: 0 8rpx 8rpx 0;
  border-radius: var(--r-pill);
  background: var(--color-fill);
  color: var(--color-text-2);
  font-size: 24rpx;
  box-sizing: border-box;
}
.tab-on {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

/* 图标区：固定高度，正好两行（88 + 8×2 = 104rpx / 行 → 208rpx）。
   固定而非 max-height：否则切换分栏时图标数量不同，面板会上下跳动。 */
.icon-scroll {
  flex-shrink: 0;
  height: 208rpx;
  margin-top: 12rpx;
}
.icon-grid {
  display: flex;
  flex-wrap: wrap;
}
.icon-item {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border-radius: 16rpx;
  margin: 8rpx;
  background: var(--color-bg);
}
/* 自定义图标用图片渲染，必须显式尺寸 + 圆角，避免原图比例把格子撑变形 */
.icon-img-item {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  margin: 8rpx;
  background: var(--color-bg);
}

/* 自定义分栏空态：撑满固定高度，保证面板高度不因空态而变矮 */
.custom-empty {
  height: 208rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  text-align: center;
}
.custom-empty-title {
  font-size: 26rpx;
  color: var(--color-text-2);
}
.custom-empty-desc {
  font-size: 22rpx;
  color: var(--color-text-3);
  padding: 0 24rpx;
  line-height: 1.5;
}

.longpress-hint {
  flex-shrink: 0;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-3);
}

.custom-btn {
  flex-shrink: 0;
  margin-top: 8rpx;
  text-align: center;
  padding: 20rpx 0 8rpx;
  font-size: 28rpx;
  color: var(--color-primary);
  border-top: 1rpx solid var(--color-divider);
}
.custom-hint {
  flex-shrink: 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.close-btn {
  flex-shrink: 0;
  margin-top: 8rpx;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-3);
}
