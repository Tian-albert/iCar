.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.picker-panel {
  width: 100%;
  background: var(--color-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 图标变多后，面板不能无限长，否则小屏会顶出屏幕 */
  max-height: 84vh;
  display: flex;
  flex-direction: column;
}
.picker-title {
  flex-shrink: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

/* 分栏：横向可滚动，避免加新分组后挤压换行。
   必须显式定高 + align-items:center —— 否则作为 scroll-view 的 flex 子项
   会被 stretch 拉成很高的气泡，且文字贴在上沿。 */
.tab-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  /* 比 chip 高 8rpx，留出居中余量，避免恰好等高时边缘被裁 */
  height: 64rpx;
  white-space: nowrap;
  margin-top: 24rpx;
}
.tab {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  /* line-height:1 配合上面的 flex 居中，文字才真正居中，不依赖字体默认行高 */
  line-height: 1;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: var(--r-pill);
  background: var(--color-fill);
  color: var(--color-text-2);
  font-size: 24rpx;
  box-sizing: border-box;
}
.tab-on {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

/* 图标区：可纵向滚动，最多占面板一半高度 */
.icon-scroll {
  flex-shrink: 1;
  max-height: 560rpx;
  margin-top: 16rpx;
}
.icon-grid {
  display: flex;
  flex-wrap: wrap;
}
.icon-item {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border-radius: 16rpx;
  margin: 8rpx;
  background: var(--color-bg);
}

.custom-btn {
  flex-shrink: 0;
  margin-top: 8rpx;
  text-align: center;
  padding: 20rpx 0 8rpx;
  font-size: 28rpx;
  color: var(--color-primary);
  border-top: 1rpx solid var(--color-divider);
}
.custom-hint {
  flex-shrink: 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.close-btn {
  flex-shrink: 0;
  margin-top: 8rpx;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-3);
}
