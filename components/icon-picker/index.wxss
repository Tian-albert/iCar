.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.picker-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.picker-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2430;
}
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.icon-item {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border-radius: 16rpx;
  margin: 8rpx;
  background: #f5f6f8;
}
.custom-btn {
  margin-top: 16rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #3b6ff6;
  border-top: 1rpx solid #f0f1f4;
}
.close-btn {
  margin-top: 8rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #9aa4b2;
}
