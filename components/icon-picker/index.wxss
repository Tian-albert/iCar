.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.picker-panel {
  width: 100%;
  background: var(--color-card);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.picker-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.icon-item {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border-radius: 16rpx;
  margin: 8rpx;
  background: var(--color-bg);
}
.custom-btn {
  margin-top: 16rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--color-primary);
  border-top: 1rpx solid var(--color-divider);
}
.close-btn {
  margin-top: 8rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--color-text-3);
}
