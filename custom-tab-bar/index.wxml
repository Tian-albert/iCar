<view class="tab-bar" style="transform: translateX({{offsetX}}px);">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index && !dragging ? 'tab-active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab">
    <image
      class="tab-icon"
      src="{{selected === index ? fillIcons[item.icon] : lineIcons[item.icon]}}"
      mode="aspectFit" />
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>
