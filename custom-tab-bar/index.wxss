/* 悬浮胶囊底部栏：脱离屏幕底部、毛玻璃背景、选中项淡蓝底块 */
.tab-bar {
  position: fixed;
  /* 左右留白 + 底部留白，让胶囊真正「浮」起来 */
  left: 28rpx;
  right: 28rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 108rpx;
  padding: 0 8rpx;
  box-sizing: border-box;

  /*
   * 毛玻璃：刻意做得「不敏感」。
   *
   * 原来的 saturate(180%) 会把背后内容的色彩变化放大 —— swiper 横向滑动时
   * 底栏采到的内容一直在变，视觉上就像底栏自己在动。
   * 现在去掉 saturate、降低 blur、提高底不透明度，让底栏在滑动中**看起来是静止的**。
   */
  background: rgba(252, 253, 255, 0.86);
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
  /* 高光描边：上边偏亮，模拟玻璃厚度 */
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.12), 0 2rpx 6rpx rgba(15, 23, 42, 0.05);
  z-index: 100;
}

/*
 * 指示块：选中项的浅蓝底块。
 * 绝对定位在胶囊内，随滑动连续位移（transform 由 JS 驱动）。
 * 宽度与每个 tab 等宽，由 left:0 + width:33.33% 决定，translateX 按 tab 步长给。
 *
 * **不要加 transition**：滑动中每帧都会写入新的 transform，
 * 有 transition 就会每帧重启一次过渡，永远追不上手指 → 明显抖动/闪烁。
 * 松手后的平滑归位由 swiper 自己的切换动画驱动，不需要 CSS 过渡。
 */
.tab-indicator {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 3);
  height: 92rpx;
  border-radius: 46rpx;
  background: rgba(59, 111, 246, 0.12);
  pointer-events: none;
  /* 独立合成层：避免每帧重排，位移只走合成 */
  will-change: transform;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  position: relative;
  z-index: 1;
}

/*
 * 图标：描边层与实心层叠加，靠 opacity 切换。
 * 不用「切 src」是因为换图会触发重新解码，滑动中每帧都换就会闪烁。
 */
.tab-icon-wrap {
  position: relative;
  width: 46rpx;
  height: 46rpx;
}

.tab-icon {
  position: absolute;
  top: 0;
  left: 0;
  width: 46rpx;
  height: 46rpx;
}

.tab-icon-line {
  opacity: 1;
  transition: opacity 0.15s ease;
}

.tab-icon-fill {
  opacity: 0;
  transition: opacity 0.15s ease;
}

.tab-icon-fill.on {
  opacity: 1;
}

/* 自定义组件默认样式隔离，取不到页面级 CSS 变量，此处用字面量 */
.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #6B7486;
  transition: color 0.15s ease;
}

.tab-text-on {
  color: #3B6FF6;
  font-weight: 600;
}
