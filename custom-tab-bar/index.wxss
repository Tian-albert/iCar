/* 悬浮胶囊底部栏：脱离屏幕底部、毛玻璃背景、选中项淡蓝底块 */
.tab-bar {
  position: fixed;
  /* 左右留白 + 底部留白，让胶囊真正「浮」起来 */
  left: 28rpx;
  right: 28rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 108rpx;
  padding: 0 8rpx;
  box-sizing: border-box;

  background: rgba(255, 255, 255, 0.62);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  /* 高光描边：上边偏亮，模拟玻璃厚度 */
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.12), 0 2rpx 6rpx rgba(15, 23, 42, 0.05);
  z-index: 100;
}

/*
 * 指示块：选中项的浅蓝底块。
 * 绝对定位在胶囊内，随滑动连续位移（transform 由 JS 驱动）。
 * 宽度与每个 tab 等宽，由 left:0 + width:33.33% 决定，translateX 按 tab 步长给。
 */
.tab-indicator {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 3);
  height: 92rpx;
  border-radius: 46rpx;
  background: rgba(59, 111, 246, 0.12);
  pointer-events: none;
  transition: transform 0.12s ease-out;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  position: relative;
  z-index: 1;
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
}

/* 自定义组件默认样式隔离，取不到页面级 CSS 变量，此处用字面量 */
.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #6B7486;
  transition: color 0.15s ease;
}

.tab-text-on {
  color: #3B6FF6;
  font-weight: 600;
}
