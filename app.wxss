/* iCar 设计令牌（对应设计报告 6.1） */
page {
  /* 颜色 */
  --color-primary: #3B6FF6;
  --color-primary-light: #EEF3FE;
  --color-bg: #F5F6F8;
  --color-card: #FFFFFF;
  --color-text-1: #1F2430;
  --color-text-2: #5A6272;
  --color-text-3: #9AA4B2;
  --color-danger: #F5474F;
  --color-success: #2BA84A;
  --color-success-bg: #E8F7EE;
  --color-warning: #E8912A;
  --color-warning-bg: #FFF3E0;
  --color-dark-card: #1E2536;

  /* 图表 */
  --chart-1: #3B82F6;
  --chart-2: #22C55E;
  --chart-3: #F59E0B;
  --chart-4: #EF4444;
  --chart-5: #A855F7;
  --chart-6: #14B8A6;
  --chart-grid: #EEF0F3;
  --chart-axis: #9AA4B2;

  /* 圆角与间距（历史 px 系列，保持兼容；新代码优先用下方 rpx 系列） */
  --radius-card: 16px;
  --radius-pill: 10px;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;

  /* UI 审计补齐：语义色（见 docs/DESIGN.md） */
  --color-divider: #F0F1F4;
  --color-fill: #F2F3F5;
  --color-border: #E6EAF1;
  --color-text-4: #8A93A6;
  --color-primary-dark: #1D4ED8;

  /* 字号阶梯（px；自定义属性值避免 rpx，见 docs/DESIGN.md 第 1 节） */
  --font-xs: 11px;
  --font-sm: 12px;
  --font-md: 14px;
  --font-lg: 16px;
  --font-xl: 20px;

  /* 间距阶梯（px，按 375px 屏与 rpx 等价换算） */
  --sp-1: 4px;
  --sp-2: 8px;
  --sp-3: 12px;
  --sp-4: 16px;
  --sp-5: 24px;

  /* 圆角（px） */
  --r-sm: 4px;
  --r-md: 8px;
  --r-lg: 12px;
  --r-pill: 999px;

  /* 阴影为复合值，不定义为自定义属性（WXSS 对含函数/逗号的变量值兼容性不稳），
     使用处直接写字面量，见 docs/DESIGN.md 第 4 节 */

  background-color: var(--color-bg);
  color: var(--color-text-1);
  font-size: 15px;
}

/* ---------- 全局通用类（见 docs/DESIGN.md 第 5 节） ---------- */

/* 空态：图标 + 标题 + 说明，可再附一个引导动作 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty-state-icon {
  font-size: 96rpx;
  line-height: 1;
}
.empty-state-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-2);
}
.empty-state-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-3);
}
.empty-state-action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--r-pill);
}

/* 卡片：全项目统一内边距与阴影，各页只保留自身差异（margin 等） */
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--sp-3) var(--sp-4);
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

/* 主按钮：全项目统一形态 */
.btn-primary {
  background: var(--color-primary);
  color: var(--color-card);
  border-radius: var(--r-pill);
  font-size: var(--font-lg);
  line-height: 2.6;
}
.btn-primary[disabled] {
  opacity: 0.5;
}

/* 按下反馈：所有可点击元素都应挂 hover-class="hover-dim" */
.hover-dim {
  opacity: 0.6;
}
