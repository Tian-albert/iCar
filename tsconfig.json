{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "lib": ["ES2017"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "types": ["miniprogram-api-typings"],
    "outDir": "./dist"
  },
  "include": ["typings/**/*", "types/**/*", "domain/**/*", "repositories/**/*", "services/**/*", "store/**/*", "utils/**/*", "components/**/*", "custom-tab-bar/**/*", "app.ts", "pages/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
