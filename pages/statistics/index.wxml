<view class="page">
  <!-- 维度切换 -->
  <view class="range-bar">
    <view class="seg-tabs">
      <view hover-class="hover-dim" class="seg {{rangeType === 'month' ? 'seg-active' : ''}}" data-type="month" bindtap="onRangeChange">月</view>
      <view hover-class="hover-dim" class="seg {{rangeType === 'year' ? 'seg-active' : ''}}" data-type="year" bindtap="onRangeChange">年</view>
      <view hover-class="hover-dim" class="seg {{rangeType === 'all' ? 'seg-active' : ''}}" data-type="all" bindtap="onRangeChange">全部</view>
    </view>
    <view class="range-pickers">
      <picker wx:if="{{rangeType !== 'all'}}" range="{{years}}" value="{{yearIndex}}" bindchange="onYearChange">
        <view class="picker-value">{{year}}年 ▾</view>
      </picker>
      <picker wx:if="{{rangeType === 'month'}}" range="{{months}}" value="{{month - 1}}" bindchange="onMonthChange">
        <view class="picker-value">{{month}}月 ▾</view>
      </picker>
    </view>
  </view>

  <!-- 里程数据 -->
  <view class="metric-card">
    <view class="metric-col">
      <view class="metric-value">{{mileageLatest}}</view>
      <view class="metric-label">最新总里程 (km)</view>
    </view>
    <view class="metric-col">
      <view class="metric-value">{{mileageIncreased}}</view>
      <view class="metric-label">增加总里程 (km)</view>
    </view>
    <view class="metric-col">
      <view class="metric-value">{{mileageFuel}}</view>
      <view class="metric-label">{{mileageLabel}}</view>
    </view>
  </view>

  <!-- 油耗数据（纯电车隐藏） -->
  <view wx:if="{{!isEvCar}}" class="metric-card">
    <view class="metric-col">
      <view class="metric-value">{{fuelTotalCost}}</view>
      <view class="metric-label">总油费 (元)</view>
    </view>
    <view class="metric-col">
      <view class="metric-value">{{fuelAvgConsumption}}</view>
      <view class="metric-label">平均油耗 (L/100km)</view>
    </view>
    <view class="metric-col">
      <view class="metric-value">{{fuelCostPerKm}}</view>
      <view class="metric-label">平均油耗 (元/km)</view>
    </view>
  </view>

  <!-- 电耗数据（纯电 / 混动，R-07） -->
  <view wx:if="{{isEvCar || isHybridCar}}" class="metric-card">
    <view class="metric-col">
      <view class="metric-value">{{chargeTotalCost}}</view>
      <view class="metric-label">总电费 (元)</view>
    </view>
    <view class="metric-col">
      <view class="metric-value">{{chargeAvgConsumption}}</view>
      <view class="metric-label">平均电耗 (kWh/100km)</view>
    </view>
    <view class="metric-col">
      <view class="metric-value">{{chargeCostPerKm}}</view>
      <view class="metric-label">每公里电费 (元/km)</view>
    </view>
  </view>

  <!-- 支出数据 -->
  <view class="metric-card">
    <view class="metric-col">
      <view class="metric-value">{{expenseTotal}}</view>
      <view class="metric-label">总支出 (元)</view>
    </view>
    <view class="metric-col">
      <view class="metric-value">{{expensePerKm}}</view>
      <view class="metric-label">每公里支出 (元/km)</view>
    </view>
    <view class="metric-col">
      <view class="metric-value">{{expensePerKmExFuel}}</view>
      <view class="metric-label">除掉油费 (元/km)</view>
    </view>
  </view>

  <!-- 分类支出 -->
  <view class="cat-header">
    <view class="cat-title">分类支出</view>
    <view wx:if="{{hasData}}" class="cat-total">总支出 <text class="cat-total-num">¥{{expenseTotal}}</text></view>
  </view>
  <view class="card cat-card">
    <view wx:if="{{!hasData || categories.length === 0}}" class="chart-empty">暂无支出数据，记一笔后即可查看分类占比</view>
    <block wx:else>
      <donut-chart segments="{{categories}}" total="{{expenseTotal}}" class="donut-chart" />
      <view class="cat-list">
        <view wx:for="{{categories}}" wx:key="name" class="cat-row">
          <view class="cat-dot" style="background: {{item.color}};"></view>
          <view class="cat-name">{{item.name}}</view>
          <view class="cat-amount">¥ {{item.amount}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 油耗趋势 -->
  <view class="section-title">{{isEvCar ? '电耗' : '能耗'}}趋势 ({{trendUnit}})</view>
  <view class="card">
    <view wx:if="{{trend.length === 0}}" class="chart-empty">{{isEvCar ? '暂无有效充电区间，记录两次充满充电后生成趋势' : '暂无有效油耗区间，记录两次加满加油后生成趋势'}}</view>
    <line-chart wx:else class="chart" points="{{trend}}" yMax="{{15}}" unit="{{trendUnit}}" />
  </view>

  <!-- 行程 -->
  <view class="section-title">行程 (km)</view>
  <view class="card">
    <view wx:if="{{monthlyMileage.length === 0}}" class="chart-empty">暂无行程数据</view>
    <bar-chart wx:else class="chart" bars="{{monthlyMileage}}" unit="km" />
  </view>

  <!-- 费用 -->
  <view class="section-title">费用 (元)</view>
  <view class="card">
    <view wx:if="{{monthlyCost.length === 0}}" class="chart-empty">暂无费用数据</view>
    <bar-chart wx:else class="chart" bars="{{monthlyCost}}" unit="元" />
  </view>

  <!-- 分享统计卡片 -->
  <view class="share-bar">
    <button
      class="btn-share"
      hover-class="btn-share-hover"
      loading="{{sharing}}"
      disabled="{{sharing}}"
      bindtap="onShareStatistics"
    >生成统计图片</button>
    <view class="share-hint">可发送给朋友、分享到朋友圈或保存到相册</view>
  </view>

  <!-- 离屏画布：仅用于导出分享图，视觉上不可见 -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
