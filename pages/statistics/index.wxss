.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.range-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.seg-tabs {
  display: flex;
  background: var(--color-divider);
  border-radius: var(--radius-pill);
  padding: 4rpx;
}
.seg {
  padding: 10rpx 32rpx;
  font-size: 28rpx;
  color: var(--color-text-2);
  border-radius: var(--radius-pill);
}
.seg-active {
  background: var(--color-card);
  color: var(--color-primary);
  font-weight: 600;
}
.range-pickers {
  display: flex;
  gap: 16rpx;
}
.picker-value {
  font-size: 28rpx;
  color: var(--color-text-2);
}
.metric-card {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx 0;
  margin-bottom: 20rpx;
}
.metric-col {
  flex: 1;
  text-align: center;
}
.metric-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.cat-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 0 16rpx;
}
.cat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.cat-total {
  font-size: 24rpx;
  color: var(--color-text-2);
}
.cat-total-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}
.cat-card {
  padding: 24rpx;
}
.donut-chart {
  display: block;
  width: 100%;
  height: 500rpx;
}
.cat-list {
  /* 首行自带 padding-top，这里不再叠加外边距 */
  margin-top: 0;
}
.cat-row {
  display: flex;
  align-items: center;
  /*
   * 左右负外边距抵消 padding：内容起始位置与改动前完全一致，
   * 只是多出一圈可点击热区；上下 padding 合计 16rpx，正好接替原来的 margin-bottom 行距。
   */
  margin: 0 -12rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
}
/* 选中态：与概览页图例 .lg-on 同一套语义（浅色填充） */
.cat-row.cat-on {
  background: var(--color-fill);
}
.cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.cat-name {
  /* 定宽而非 flex:1 —— 让各行的比例条起点对齐，长度才可比 */
  width: 120rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/*
 * 占比条：轨道固定宽度，内部填充按 percent 撑开。
 * 纯 CSS 宽度百分比，不依赖 canvas。
 */
.cat-bar-track {
  flex: 1;
  height: 12rpx;
  margin: 0 16rpx;
  border-radius: 6rpx;
  background: var(--color-fill);
  overflow: hidden;
}
.cat-bar {
  height: 100%;
  border-radius: 6rpx;
  /* 占比极小时也留一点可见宽度，否则 1% 的项看起来像没有数据 */
  min-width: 4rpx;
}
.cat-amount {
  width: 150rpx;
  text-align: right;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.chart {
  display: block;
  width: 100%;
  height: 300rpx;
}
.chart-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-3);
  line-height: 1.6;
}

/* 分享统计卡片 */
.share-bar {
  margin: 48rpx 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.btn-share {
  background: var(--color-primary);
  color: var(--color-on-dark);
  border-radius: var(--r-pill);
  font-size: var(--font-lg);
  line-height: 2.8;
}
.btn-share-hover {
  opacity: 0.85;
}
.btn-share[disabled] {
  opacity: 0.6;
}
.share-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}

/* 离屏画布：仅用于导出分享图。
   far off-screen 但保留渲染；尺寸用 rpx 保证不撑破页面，
   实际绘制尺寸由 canvas.width/height 按 dpr 决定，与 CSS 尺寸无关。

   额外加 opacity: 0：position: fixed 一旦遇到带 transform/filter 的祖先，
   会改以该祖先为包含块、落到可视区内；只靠 left 负值不够稳。 */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750rpx;
  height: 1200rpx;
  opacity: 0;
  pointer-events: none;
}
