.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.range-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.seg-tabs {
  display: flex;
  background: #eceef2;
  border-radius: var(--radius-pill);
  padding: 4rpx;
}
.seg {
  padding: 10rpx 32rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
  border-radius: var(--radius-pill);
}
.seg-active {
  background: #fff;
  color: var(--color-primary);
  font-weight: 600;
}
.range-pickers {
  display: flex;
  gap: 16rpx;
}
.picker-value {
  font-size: 26rpx;
  color: var(--color-text-2);
}
.metric-card {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx 0;
  margin-bottom: 20rpx;
}
.metric-col {
  flex: 1;
  text-align: center;
}
.metric-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 24rpx;
}
.cat-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 0 16rpx;
}
.cat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.cat-total {
  font-size: 24rpx;
  color: var(--color-text-2);
}
.cat-total-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}
.cat-card {
  padding: 24rpx;
}
.donut-chart {
  display: block;
  width: 100%;
  height: 500rpx;
}
.cat-list {
  margin-top: 8rpx;
}
.cat-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.cat-row:last-child {
  margin-bottom: 0;
}
.cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.cat-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-1);
}
.cat-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.chart {
  display: block;
  width: 100%;
  height: 300rpx;
}
