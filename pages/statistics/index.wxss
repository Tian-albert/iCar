.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.range-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.seg-tabs {
  display: flex;
  background: var(--color-divider);
  border-radius: var(--radius-pill);
  padding: 4rpx;
}
.seg {
  padding: 10rpx 32rpx;
  font-size: 28rpx;
  color: var(--color-text-2);
  border-radius: var(--radius-pill);
}
.seg-active {
  background: var(--color-card);
  color: var(--color-primary);
  font-weight: 600;
}
.range-pickers {
  display: flex;
  gap: 16rpx;
}
.picker-value {
  font-size: 28rpx;
  color: var(--color-text-2);
}
.metric-card {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx 0;
  margin-bottom: 20rpx;
}
.metric-col {
  flex: 1;
  text-align: center;
}
.metric-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.cat-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 0 16rpx;
}
.cat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.cat-total {
  font-size: 24rpx;
  color: var(--color-text-2);
}
.cat-total-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}
.cat-card {
  padding: 24rpx;
}
.donut-chart {
  display: block;
  width: 100%;
  height: 500rpx;
}
.cat-list {
  margin-top: 8rpx;
}
.cat-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.cat-row:last-child {
  margin-bottom: 0;
}
.cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.cat-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-1);
}
.cat-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.chart {
  display: block;
  width: 100%;
  height: 300rpx;
}
.chart-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-3);
  line-height: 1.6;
}

/* 分享统计卡片 */
.share-bar {
  margin: 48rpx 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.btn-share {
  background: var(--color-primary);
  color: var(--color-card);
  border-radius: var(--r-pill);
  font-size: var(--font-lg);
  line-height: 2.8;
}
.btn-share-hover {
  opacity: 0.85;
}
.btn-share[disabled] {
  opacity: 0.6;
}
.share-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--font-xs);
  color: var(--color-text-3);
}

/* 离屏画布：仅用于导出分享图。
   移出可视区但保留渲染；尺寸用 rpx 保证不撑破页面，
   实际绘制尺寸由 canvas.width/height 按 dpr 决定，与 CSS 尺寸无关。 */
.share-canvas {
  position: fixed;
  left: -200vw;
  top: 0;
  width: 750rpx;
  height: 1200rpx;
  pointer-events: none;
}
