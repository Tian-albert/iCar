.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.tip {
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
  line-height: 1.6;
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.row-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.row-remain {
  font-size: 24rpx;
  color: var(--color-primary);
}
.row-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.row-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-divider);
}
.restore-btn {
  padding: 10rpx 32rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-pill);
}
.empty {
  padding: 120rpx 0;
  text-align: center;
}
.empty-title {
  font-size: 30rpx;
  color: var(--color-text-2);
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.footer {
  margin-top: 40rpx;
}
.btn-plain {
  background: var(--color-card);
  color: var(--color-text-2);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
}
