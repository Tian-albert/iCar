<view class="page">
  <view class="tip">删除的记录保留 {{retentionDays}} 天，期间可随时恢复；过期后自动清理。</view>

  <view wx:if="{{items.length === 0}}" class="empty">
    <view class="empty-title">回收站是空的</view>
    <view class="empty-desc">删除记录后会出现在这里</view>
  </view>

  <view wx:for="{{items}}" wx:key="batch" class="card">
    <view class="row-head">
      <view class="row-title">{{item.title}}</view>
      <text class="row-remain">{{item.remainText}}</text>
    </view>
    <view class="row-meta">{{item.dateText}} · 共 {{item.count}} 条记录</view>
    <view class="row-actions">
      <view hover-class="hover-dim" class="restore-btn" data-batch="{{item.batch}}" bindtap="onRestore">恢复</view>
    </view>
  </view>

  <view wx:if="{{items.length > 0}}" class="footer">
    <button class="btn-plain" bindtap="onPurge">清理已过期记录</button>
  </view>
</view>
