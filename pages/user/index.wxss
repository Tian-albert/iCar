.page {
  min-height: 100vh;
  padding: 24rpx;
  /* 悬浮胶囊底栏：胶囊高 108rpx + 底部偏移 20rpx + 安全区 + 呼吸留白 */
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.card {
  margin-bottom: 24rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 28rpx;
  color: var(--color-text-1);
}
/* 危险操作：红色文字，配合「单独一组」形成视觉隔离 */
.row-danger {
  color: var(--color-danger);
}
.row-arrow {
  font-size: 40rpx;
  color: var(--color-text-3);
}
/* 行尾当前值（如「皮肤」右侧的皮肤名）：比标签弱一档，箭头前留 8rpx */
.row-value {
  margin-left: auto;
  margin-right: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
}
/* NEW 小标：贴箭头，与「关于」的版本号同槽位；主色胶囊表达「值得点一下」 */
.row-badge {
  margin-left: auto;
  margin-right: 8rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  /* 20rpx 并入 22rpx（DESIGN.md §10 角标档） */
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: var(--color-primary-light);
  line-height: 1.5;
  flex-shrink: 0;
}

/*
 * 「把车记本推荐给朋友」
 *
 * 视觉：直接复用 .row / .row-label / .row-arrow —— 与上面「关于」
 * 是同一套类，字号、字重、左对齐、箭头位置必然一致，不可能出现偏差。
 *
 * 分享能力：button 做成铺满整行的**透明覆盖层**，只负责 open-type="share"。
 * 之所以不让 button 承载布局，是因为微信给 button 注入了内置样式
 * （text-align:center / font-size / padding / line-height / display:block），
 * 即使写 class 覆盖，真机上仍可能不生效（已实测）。
 */
.row-share {
  position: relative;
}

/*
 * 透明覆盖层：铺满整行，只负责 open-type="share"。
 *
 * 之前用 `opacity: 0.01` 让 button 隐形，真机上只有文字区域能点 ——
 * 因为**接近 0 的透明度会被渲染层判为不可交互**，直接跳过命中测试。
 *
 * 现在的做法：元素**完全不透明**（必定参与命中测试），
 * 靠 `background/color: transparent` + `font-size: 0` 让它视觉上不可见。
 *
 * 用 inset 而不是 width/height: 100% —— button 有内置 width/padding 规则，
 * 百分比宽度压不住它，inset 才能真正铺满。
 */
.share-cover {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: auto;
  height: auto;
  z-index: 1;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: transparent;
  /* 空 button 不被内置行高/字号撑开，避免撑出可视痕迹 */
  font-size: 0;
  line-height: 0;
  overflow: hidden;
}
/* 去掉 button 默认的 ::after 边框（微信内置） */
.share-cover::after {
  border: none;
}
.version {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-3);
}
