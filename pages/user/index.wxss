.page {
  min-height: 100vh;
  padding: 24rpx;
  /* 悬浮胶囊底栏：胶囊高 108rpx + 底部偏移 20rpx + 安全区 + 呼吸留白 */
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.card {
  margin-bottom: 24rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 28rpx;
  color: var(--color-text-1);
}
/* 危险操作：红色文字，配合「单独一组」形成视觉隔离 */
.row-danger {
  color: var(--color-danger);
}
.row-arrow {
  font-size: 40rpx;
  color: var(--color-text-3);
}

/*
 * 「把车记本推荐给朋友」
 *
 * 视觉：直接复用 .row / .row-label / .row-arrow —— 与上面「关于」
 * 是同一套类，字号、字重、左对齐、箭头位置必然一致，不可能出现偏差。
 *
 * 分享能力：button 做成铺满整行的**透明覆盖层**，只负责 open-type="share"。
 * 之所以不让 button 承载布局，是因为微信给 button 注入了内置样式
 * （text-align:center / font-size / padding / line-height / display:block），
 * 即使写 class 覆盖，真机上仍可能不生效（已实测）。
 */
.row-share {
  position: relative;
}

.share-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  /*
   * 视觉上不可见，但仍**必须可点击**：
   * 用 opacity: 0.01 而不是 0 —— 部分渲染引擎下 opacity:0 的元素
   * 可能不接收点击事件，导致分享面板调不起来。
   */
  opacity: 0.01;
  z-index: 1;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}
.version {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-3);
}
