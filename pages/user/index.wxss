.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}
.user-card {
  display: flex;
  align-items: center;
  background: var(--color-dark-card);
  border-radius: var(--radius-card);
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}
.user-avatar {
  font-size: 80rpx;
  margin-right: 24rpx;
}
.user-info {
  flex: 1;
}
.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-card);
}
.card {
  margin-bottom: 24rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 28rpx;
  color: var(--color-text-1);
}
.row-arrow {
  font-size: 40rpx;
  color: var(--color-text-3);
}
.version {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-3);
}
