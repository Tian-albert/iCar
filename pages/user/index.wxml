<view class="page">
  <!-- 设置列表 -->
  <view class="card">
    <view class="row">
      <view class="row-label">保养到期提醒</view>
      <switch checked="{{remindEnabled}}" color="{{activeColor}}" bindchange="onRemindChange" />
    </view>
    <view hover-class="hover-dim" class="row" bindtap="onOpenCategory">
      <view class="row-label">支出类别管理</view>
      <view class="row-arrow">›</view>
    </view>
    <view hover-class="hover-dim" class="row" bindtap="onOpenDataTransfer">
      <view class="row-label">数据导入导出</view>
      <view class="row-arrow">›</view>
    </view>
    <view hover-class="hover-dim" class="row" bindtap="onOpenRecycleBin">
      <view class="row-label">回收站</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <!-- 危险操作单独一组：与普通设置隔开，避免误点 -->
  <view class="card">
    <view hover-class="hover-dim" class="row" bindtap="onClearAll">
      <view class="row-label row-danger">清除所有数据</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view class="card">
    <!--
      顺序有意为之：常见问题 → 反馈与建议 → 关于。
      先让用户自助找答案，找不到再去反馈；把「反馈」放前面会让人跳过自助环节。
    -->
    <view hover-class="hover-dim" class="row" bindtap="onOpenFaq">
      <view class="row-label">常见问题</view>
      <view class="row-arrow">›</view>
    </view>
    <view hover-class="hover-dim" class="row" bindtap="onFeedback">
      <view class="row-label">反馈与建议</view>
      <view class="row-arrow">›</view>
    </view>
    <view hover-class="hover-dim" class="row" bindtap="onOpenAbout">
      <view class="row-label">关于</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <!--
    推荐给朋友：单独一组放在最下，靠「位置」突出，而非靠字体样式。

    这里**不用 button 承载布局**——微信给 button 注入了内置样式
    （text-align:center / font-size / padding / line-height），
    即使写了 class 覆盖，真机上仍可能不生效。
    改法：视觉用与上面「关于」完全相同的 .row 结构，
    button 做成铺满整行的透明覆盖层，只负责触发分享。
  -->
  <view class="card">
    <view class="row row-share">
      <view class="row-label">把车记本推荐给朋友</view>
      <view class="row-arrow">›</view>
      <button class="share-cover" open-type="share" hover-class="none" />
    </view>
  </view>

  <view class="version">车记本 v1.2.0</view>
</view>
