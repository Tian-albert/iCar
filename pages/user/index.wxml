<view class="page">
  <!-- 用户信息 -->
  <view class="user-card">
    <view class="user-avatar">👤</view>
    <view class="user-info">
      <view class="user-name">{{nickname}}</view>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="card">
    <view class="row">
      <view class="row-label">保养到期提醒</view>
      <switch checked="{{remindEnabled}}" color="#3B6FF6" bindchange="onRemindChange" />
    </view>
    <view class="row" bindtap="onOpenCategory">
      <view class="row-label">支出类别管理</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row" bindtap="onOpenDataTransfer">
      <view class="row-label">数据导入导出</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="onComing">
      <view class="row-label">常见问题</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row" bindtap="onComing">
      <view class="row-label">反馈与建议</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row" bindtap="onComing">
      <view class="row-label">更新日志</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row" bindtap="onOpenAbout">
      <view class="row-label">关于</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view class="version">车记本 v1.0.2</view>
</view>
