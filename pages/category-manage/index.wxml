<page-meta page-style="{{pageStyle}}" />
<view class="page">
  <view class="section-title">支出类别</view>
  <view class="tip">点图标可更换，长按右侧 ≡ 上下拖动排序</view>
  <view class="tip-note">加油 / 充电 / 保养 / 维修 由各自记录页自动归类，不在此设置</view>

  <!-- 预设与自定义已合并为一组，每行的操作完全一致 -->
  <view class="card">
    <view
      wx:for="{{categories}}"
      wx:key="sourceId"
      class="row {{dragging && dragId === item.sourceId ? 'drag-row' : ''}}">
      <image wx:if="{{item.isImage}}" class="row-icon-img" src="{{item.icon}}" data-id="{{item.sourceId}}" bindtap="onPickIcon" />
      <view hover-class="hover-dim" wx:else class="row-icon" data-id="{{item.sourceId}}" bindtap="onPickIcon">{{item.emoji}}</view>
      <view class="row-name">{{item.name}}</view>
      <text hover-class="hover-dim" class="act edit" data-id="{{item.sourceId}}" data-name="{{item.name}}" bindtap="onEdit">编辑</text>
      <text hover-class="hover-dim" class="act delete" data-id="{{item.sourceId}}" data-name="{{item.name}}" bindtap="onDelete">删除</text>
      <switch checked="{{item.visible}}" color="{{activeColor}}" data-id="{{item.sourceId}}" bindchange="onToggleVisible" />
      <view
        class="drag-handle {{dragging && dragId === item.sourceId ? 'drag-handle-active' : ''}}"
        data-id="{{item.sourceId}}"
        bindtouchstart="onHandleTouchStart"
        catchlongpress="onDragStart"
        catchtouchmove="onDragMove"
        bindtouchend="onDragEnd"
        bindtouchcancel="onDragEnd">≡</view>
    </view>
    <view wx:if="{{categories.length === 0}}" class="empty">暂无支出类别</view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="onAdd">＋ 添加类别</button>
  </view>

  <icon-picker show="{{pickerShow}}" bind:select="onIconSelect" bind:close="onPickerClose" />
</view>
