<view class="page">
  <view class="section-title">预设分类</view>
  <view class="tip">点图标可更换，长按右侧 ≡ 上下拖动排序</view>
  <view class="card">
    <view wx:for="{{presets}}" wx:key="sourceId" class="row {{dragging && dragId === item.sourceId ? 'drag-row' : ''}}">
      <image wx:if="{{item.isImage}}" class="row-icon-img" src="{{item.icon}}" data-id="{{item.sourceId}}" bindtap="onPickIcon" />
      <view wx:else class="row-icon" data-id="{{item.sourceId}}" bindtap="onPickIcon">{{item.emoji}}</view>
      <view class="row-name">{{item.name}}</view>
      <switch checked="{{item.visible}}" color="#3B6FF6" data-id="{{item.sourceId}}" bindchange="onToggleVisible" />
      <view
        class="drag-handle {{dragging && dragId === item.sourceId ? 'drag-handle-active' : ''}}"
        data-id="{{item.sourceId}}"
        bindtouchstart="onHandleTouchStart"
        catchlongpress="onDragStart"
        catchtouchmove="onDragMove"
        bindtouchend="onDragEnd"
        bindtouchcancel="onDragEnd">≡</view>
    </view>
  </view>

  <view class="section-title">自定义分类</view>
  <view class="tip">点图标可更换，长按右侧 ≡ 上下拖动排序</view>
  <view class="card">
    <view wx:for="{{customs}}" wx:key="sourceId" class="row {{dragging && dragId === item.sourceId ? 'drag-row' : ''}}">
      <image wx:if="{{item.isImage}}" class="row-icon-img" src="{{item.icon}}" data-id="{{item.sourceId}}" bindtap="onPickIcon" />
      <view wx:else class="row-icon" data-id="{{item.sourceId}}" bindtap="onPickIcon">{{item.emoji}}</view>
      <view class="row-name">{{item.name}}</view>
      <text class="act edit" data-id="{{item.sourceId}}" data-name="{{item.name}}" bindtap="onEdit">编辑</text>
      <text class="act delete" data-id="{{item.sourceId}}" data-name="{{item.name}}" bindtap="onDelete">删除</text>
      <switch checked="{{item.visible}}" color="#3B6FF6" data-id="{{item.sourceId}}" bindchange="onToggleVisible" />
      <view
        class="drag-handle {{dragging && dragId === item.sourceId ? 'drag-handle-active' : ''}}"
        data-id="{{item.sourceId}}"
        bindtouchstart="onHandleTouchStart"
        catchlongpress="onDragStart"
        catchtouchmove="onDragMove"
        bindtouchend="onDragEnd"
        bindtouchcancel="onDragEnd">≡</view>
    </view>
    <view wx:if="{{customs.length === 0}}" class="empty">暂无自定义分类</view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="onAdd">＋ 添加类别</button>
  </view>

  <icon-picker show="{{pickerShow}}" bind:select="onIconSelect" bind:close="onPickerClose" />
</view>
