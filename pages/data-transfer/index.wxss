.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.tip {
  margin: 16rpx 0 24rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
  line-height: 1.6;
}
.json-input {
  width: 100%;
  height: 360rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
}
.btn-secondary {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: var(--radius-pill);
  font-size: 30rpx;
}
.file-btn {
  margin-top: 20rpx;
}
