.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.tip {
  margin: 16rpx 0 24rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
  line-height: 1.6;
}
/* 「包含自定义图标」开关行 */
.opt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  border-top: 1rpx solid var(--color-divider);
}
.opt-text {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}
.opt-title {
  font-size: 28rpx;
  color: var(--color-text-1);
}
.opt-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-3);
}
.json-input {
  width: 100%;
  height: 360rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
.btn-primary {
  background: var(--color-primary);
  color: var(--color-card);
  border-radius: var(--r-pill);
  font-size: 32rpx;
}
.btn-secondary {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: var(--radius-pill);
  font-size: 32rpx;
}
.file-btn {
  margin-top: 20rpx;
}
