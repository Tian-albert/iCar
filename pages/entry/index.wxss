.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
/* 分段器 */
.seg-tabs {
  display: flex;
  background: var(--chart-grid);
  border-radius: var(--radius-pill);
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.seg {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-2);
  border-radius: var(--radius-pill);
}
.seg-active {
  background: var(--color-card);
  color: var(--color-primary);
  font-weight: 600;
}
/* 卡片与表单 */
.card {
  margin-bottom: var(--sp-3);
}
/* 统一的按下反馈（见 docs/DESIGN.md 第 5 节） */
.hover-dim {
  opacity: 0.6;
}
.group-title {
  padding: 24rpx 0 8rpx;
  font-size: 28rpx;
  color: var(--color-text-3);
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  width: 300rpx;
  font-size: 28rpx;
  color: var(--color-text-1);
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.form-value {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--color-text-2);
}
.form-value.readonly {
  color: var(--color-text-3);
}
.required {
  color: var(--color-danger);
}
/* 混动车：加油 / 充电模式切换 */
.mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.mode-opt {
  flex: 1;
  padding: 18rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-2);
  background: var(--color-card);
  border-radius: var(--radius-pill);
}
.mode-opt.mode-active {
  background: var(--color-primary);
  color: var(--color-card);
  font-weight: 600;
}
/* 加油选项：三组两段式开关同排 */
.opt-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 24rpx;
}
.opt-group {
  flex: 1;
  min-width: 0;
}
.opt-label {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
  text-align: center;
}
.seg-control {
  display: flex;
  background: var(--color-fill);
  border-radius: 8rpx;
  padding: 4rpx;
}
.seg-opt {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--color-text-2);
  border-radius: 8rpx;
}
.seg-opt-active {
  background: var(--color-card);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.08);
}
/* 保养项栅格
   刻意用 mnt- 前缀而非 cat-：本页下方「支出类别」已占用 .cat-item / .cat-name，
   且它是横向单行滚动、尺寸完全不同，复用类名会互相污染。
   尺寸与 pages/maintain-form 的保养栅格保持一致（见 docs/prototype/maintain-picker.html）。 */
.mnt-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
}
.mnt-item {
  flex: 0 0 auto;
  /* 卡片内宽 638rpx：3 × 196 + 2 × 16 = 620rpx，留 18rpx 余量防换行抖动 */
  width: 196rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx 14rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg);
  border: 2rpx solid transparent;
}
.mnt-active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}
.mnt-icon {
  font-size: 44rpx;
  line-height: 1;
}
/* 自定义图片图标：与 emoji 同尺寸，避免布局跳动 */
.mnt-icon-img {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
}
.mnt-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-1);
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mnt-active .mnt-name {
  color: var(--color-primary);
  font-weight: 600;
}
.mnt-cycle {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-3);
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mnt-active .mnt-cycle {
  color: var(--color-primary);
  opacity: 0.8;
}
/* 支出类别 */
.cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.manage-link {
  font-size: 28rpx;
  color: var(--color-primary);
}
.cat-scroll {
  white-space: nowrap;
  padding: 8rpx 0 24rpx;
}
.cat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-right: 12rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg);
}
.cat-active {
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
}
.cat-emoji {
  font-size: 36rpx;
}
/* 自定义图片图标：与 emoji 同尺寸，避免布局跳动 */
.cat-emoji-img {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  margin: 0 auto;
}
.cat-name {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-2);
}
.cat-active .cat-name {
  color: var(--color-primary);
}
.tip {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.footer {
  margin-top: 8rpx;
}
.btn-primary {
  background: var(--color-primary);
  color: var(--color-card);
  border-radius: var(--r-pill);
  font-size: 32rpx;
}
