.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}
.logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
}
.app-name {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.app-version {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 8rpx 32rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f0f1f4;
}
.row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 28rpx;
  color: var(--color-text-1);
}
.row-arrow {
  font-size: 40rpx;
  color: var(--color-text-3);
}
.row-value {
  font-size: 26rpx;
  color: var(--color-text-2);
}
.row-value.link {
  color: var(--color-primary);
}
.footer {
  margin-top: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-3);
}
