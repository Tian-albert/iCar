.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.date {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.section {
  margin-top: 40rpx;
}
.h {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.p {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-2);
}
