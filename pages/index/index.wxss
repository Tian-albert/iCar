.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* ---------- 顶部 ---------- */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}
.top-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
/* 添加车辆属低频动作，收成右上角图标，不再占用底部主按钮位 */
.top-add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-fill);
  color: var(--color-text-2);
  font-size: 32rpx;
  line-height: 56rpx;
  text-align: center;
}
.overview {
  padding: 0 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.ov-warn {
  color: var(--color-danger);
}

/* ---------- 主车 Hero ---------- */
.hero {
  padding: 32rpx 28rpx 24rpx;
  background: var(--color-dark-card);
  border-radius: var(--radius-card);
  box-shadow: 0 10rpx 28rpx rgba(30, 37, 54, 0.18);
}
.hero-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.hero-icon {
  font-size: 60rpx;
  line-height: 1;
  flex-shrink: 0;
}
.hero-icon-img {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.hero-info {
  flex: 1;
  min-width: 0;
}
.hero-name {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--color-card);
}
.hero-pin {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.18);
  color: var(--color-card);
  font-size: 20rpx;
  font-weight: 400;
  vertical-align: middle;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.62);
}
/* 主车取消置顶：低调文字按钮，不抢「记一笔」的视觉权重 */
.hero-unpin {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.1);
}

/* 三个关键指标 */
.hero-metrics {
  display: flex;
  margin: 28rpx 0 24rpx;
}
.hm-cell {
  flex: 1;
  text-align: center;
}
.hm-val {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-card);
}
.hm-lbl {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 主按钮 */
.hero-cta {
  padding: 26rpx 0;
  border-radius: var(--r-pill);
  background: var(--color-card);
  color: var(--color-dark-card);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}
.hero-cta-dim {
  opacity: 0.86;
}

/* 动作区：统计 / 保养 / 记录 */
.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}
.ha-item {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  text-align: center;
}
.hero-dim {
  opacity: 0.6;
}

/* ---------- 其他车辆 ---------- */
.sec-title {
  margin: 32rpx 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.cc-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  background: var(--color-card);
  border-radius: var(--radius-card);
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}
.cc-icon {
  font-size: 48rpx;
  line-height: 1;
  flex-shrink: 0;
}
.cc-icon-img {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.cc-body {
  flex: 1;
  min-width: 0;
}
.cc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cc-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.cc-right {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-shrink: 0;
}
.cc-state {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.cc-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.cc-dot.ok {
  background: var(--color-success);
}
.cc-dot.warn {
  background: var(--color-warning);
}
.cc-dot.bad {
  background: var(--color-danger);
}
.cc-state.warn {
  color: var(--color-warning);
}
.cc-state.bad {
  color: var(--color-danger);
}
/* 置顶：文字按钮，比 📍 图标语义明确（📍 是"位置"不是"置顶"） */
.cc-pin {
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
}
/* 每车一步记账：不冒泡，避免误触进详情 */
.cc-plus {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: var(--color-card);
  font-size: 34rpx;
  line-height: 56rpx;
  text-align: center;
}
.cc-plus-dim {
  opacity: 0.7;
}
