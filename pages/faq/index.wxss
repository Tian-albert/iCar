/*
 * 常见问题页。
 *
 * 这是二级页（从设置页 navigateTo 进入），**没有底部胶囊栏**，
 * 所以底部留白按二级页处理：40rpx + 安全区，不需要 168rpx。
 */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.group-title {
  font-size: 24rpx;
  color: var(--color-text-3);
  font-weight: 600;
  margin: 8rpx 0 16rpx 8rpx;
  letter-spacing: 1rpx;
}

.card {
  margin-bottom: 24rpx;
}

.faq-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.faq-item:last-child {
  border-bottom: none;
}

.faq-q {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.faq-q-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-1);
  line-height: 1.45;
  padding-right: 16rpx;
}

/* 展开指示箭头：收起时朝右，展开时旋转 90° 朝下 */
.faq-chev {
  flex-shrink: 0;
  font-size: 32rpx;
  /* 用 text-3 而非 text-4：text-4 在白底上对比度不达标（tests/contrast.test.ts 有约束） */
  color: var(--color-text-3);
  line-height: 1.2;
  transition: transform 0.2s ease;
}
.faq-chev-open {
  transform: rotate(90deg);
}

.faq-a {
  margin-top: 16rpx;
  padding-right: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
  line-height: 1.7;
}

.faq-foot {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-3);
  line-height: 1.6;
  padding: 24rpx 0 8rpx;
}
.faq-foot-link {
  color: var(--color-primary);
  font-weight: 600;
}
