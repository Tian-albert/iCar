<view class="page">
  <!-- 空态：用户把保养项删光后不应只剩一片空白 -->
  <view wx:if="{{maintains.length === 0}}" class="empty-state">
    <view class="empty-state-icon">🔧</view>
    <view class="empty-state-title">还没有保养项目</view>
    <view class="empty-state-desc">添加常用保养项后，这里会显示每一项的剩余里程与周期</view>
    <view class="empty-state-action" hover-class="hover-dim" bindtap="onAdd">＋ 添加保养项</view>
  </view>

  <view wx:else class="card">
    <view wx:for="{{maintains}}" wx:key="sourceId" class="row" hover-class="hover-dim" data-id="{{item.sourceId}}" bindtap="onEdit">
      <view class="row-top">
        <view class="row-name-wrap">
          <image wx:if="{{item.isImage}}" class="row-icon-img" src="{{item.icon}}" />
          <text wx:else class="row-icon">{{item.emoji}}</text>
          <view class="row-name">{{item.name}}</view>
        </view>
        <view class="row-remain {{item.urgent ? 'row-urgent' : ''}}">{{item.remainText}}</view>
      </view>
      <view class="mnt-bar">
        <view class="mnt-bar-fill" style="width: {{item.progressPercent + '%'}};"></view>
      </view>
      <view class="row-cycle">周期：{{item.cycleText}}</view>
      <view class="row-tools">
        <view class="tool-link" hover-class="hover-dim" data-id="{{item.sourceId}}" catchtap="onDelete">删除</view>
      </view>
    </view>
  </view>

  <view wx:if="{{maintains.length > 0}}" class="footer">
    <button class="btn-primary" bindtap="onAdd">＋ 添加保养项</button>
  </view>
</view>
