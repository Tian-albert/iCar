<page-meta page-style="{{pageStyle}}" />
<view class="page">
  <!-- 维度切换（与车辆统计页同结构） -->
  <view class="range-bar">
    <view class="seg-tabs">
      <view hover-class="hover-dim" class="seg {{rangeType === 'month' ? 'seg-active' : ''}}" data-type="month" bindtap="onRangeChange">月</view>
      <view hover-class="hover-dim" class="seg {{rangeType === 'year' ? 'seg-active' : ''}}" data-type="year" bindtap="onRangeChange">年</view>
      <view hover-class="hover-dim" class="seg {{rangeType === 'all' ? 'seg-active' : ''}}" data-type="all" bindtap="onRangeChange">全部</view>
    </view>
    <view class="range-pickers">
      <picker wx:if="{{rangeType !== 'all'}}" range="{{years}}" bindchange="onYearChange">
        <view class="picker-value">{{year}}年 ▾</view>
      </picker>
      <picker wx:if="{{rangeType === 'month'}}" range="{{months}}" value="{{month - 1}}" bindchange="onMonthChange">
        <view class="picker-value">{{month}}月 ▾</view>
      </picker>
    </view>
  </view>

  <block wx:if="{{hasCar}}">
    <!-- 指标一：规模 -->
    <view class="metric-card">
      <view class="metric-col">
        <view class="metric-value">{{carCount}}</view>
        <view class="metric-label">车辆</view>
      </view>
      <view class="metric-col">
        <view class="metric-value">{{mileageText}}</view>
        <view class="metric-label">有效里程 (km)</view>
      </view>
      <view class="metric-col">
        <view class="metric-value">{{pendingCount}}</view>
        <view class="metric-label">到期保养项</view>
      </view>
    </view>

    <!-- 指标二：钱（不带算式，简单点） -->
    <view class="metric-card">
      <view class="metric-col">
        <view class="metric-value">{{totalText}}</view>
        <view class="metric-label">总支出</view>
      </view>
      <view class="metric-col">
        <view class="metric-value">{{perKmText}}</view>
        <view class="metric-label">每公里成本</view>
      </view>
      <view class="metric-col">
        <view class="metric-value">{{energyPercentText}}</view>
        <view class="metric-label">油电费占比</view>
      </view>
    </view>

    <!-- 费用走势：只画有数据的柱子，横轴按真实位置 -->
    <view class="sec-title">
      费用走势
      <text class="sec-unit">按 {{granularityLabel}}</text>
    </view>
    <view class="card">
      <view wx:if="{{emptyChart}}" class="chart-empty">这个区间还没有支出记录</view>
      <block wx:else>
        <view class="bars">
          <view
            wx:for="{{bars}}"
            wx:key="left"
            class="bar"
            style="left:{{item.left}};width:{{item.width}};height:{{item.height}}"
          ></view>
        </view>
        <view class="axis">
          <text wx:for="{{axis}}" wx:key="left" class="tick" style="left:{{item.left}}">{{item.text}}</text>
        </view>
      </block>
    </view>

    <!-- 分类支出 -->
    <view wx:if="{{catRows.length}}" class="sec-title">分类支出</view>
    <view wx:if="{{catRows.length}}" class="card">
      <view wx:for="{{catRows}}" wx:key="name" class="cat-row">
        <text class="cat-name">{{item.name}}</text>
        <view class="cat-track">
          <view class="cat-fill" style="width:{{item.width}};background:{{item.color}}"></view>
        </view>
        <text class="cat-amount">{{item.amountText}}</text>
      </view>
    </view>

    <!-- 各车明细：点击进单车统计页 -->
    <view class="sec-title">各车明细</view>
    <view class="card">
      <view
        wx:for="{{carRows}}"
        wx:key="carSourceId"
        hover-class="hover-dim"
        class="car-row"
        data-id="{{item.carSourceId}}"
        bindtap="onTapCar"
      >
        <view class="car-dot" style="background:{{item.color}}"></view>
        <view class="car-main">
          <view class="car-name">{{item.name}}</view>
          <view class="car-sub">{{item.subText}}</view>
        </view>
        <view class="car-amount">{{item.totalText}}</view>
        <view class="car-arrow">›</view>
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <view class="empty-title">还没有车辆</view>
    <view class="empty-desc">添加车辆后，这里会汇总所有车的支出、里程与每公里成本。</view>
  </view>
</view>
