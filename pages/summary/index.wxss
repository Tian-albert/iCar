.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

/* ---------- 维度切换（与车辆统计页一致） ---------- */
.range-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.seg-tabs {
  display: flex;
  padding: 4rpx;
  background: var(--color-fill);
  border-radius: 16rpx;
}
.seg {
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  color: var(--color-text-2);
  border-radius: 12rpx;
}
.seg-active {
  background: var(--color-card);
  color: var(--color-text-1);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.08);
}
.range-pickers {
  display: flex;
  gap: 12rpx;
}
.picker-value {
  font-size: 24rpx;
  color: var(--color-text-2);
  padding: 8rpx 16rpx;
  background: var(--color-fill);
  border-radius: 12rpx;
}

/* ---------- 指标卡 ---------- */
.metric-card {
  display: flex;
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 24rpx 0;
  margin-bottom: 16rpx;
}
.metric-col {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--color-line);
}
.metric-col:last-child {
  border-right: none;
}
.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-1);
  letter-spacing: -0.5rpx;
}
.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* ---------- 区块标题 ---------- */
.sec-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 32rpx 0 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-2);
}
/* 粒度角标：让用户知道当前图表是「日 / 月 / 年」哪一档 */
.sec-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-3);
}

/* ---------- 柱状图 ---------- */
.card {
  background: var(--color-card);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
}
/*
 * 点中柱子的气泡：钉在柱子正上方，底部小三角指向柱子。
 * left 由页面按柱中心算好，这里用 transform 定心；顶部留白让最高柱也能容纳气泡。
 */
.bars {
  position: relative;
  height: 200rpx;
  margin-bottom: 8rpx;
  padding-top: 20rpx;
}
.bar-tip {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: var(--color-primary);
  color: var(--color-on-dark);
  font-size: 20rpx;
  line-height: 1.5;
  white-space: nowrap;
  z-index: 2;
}
/* 指向柱子的小三角 */
.bar-tip::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  transform: translateX(-50%);
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid var(--color-primary);
}
/*
 * 柱子绝对定位：left/width 由页面按真实时间位置算好。
 * 只渲染有数据的桶 —— 31 根全画会糊成一片，缺档反而是「哪几天没花钱」的信息。
 */
.bar {
  position: absolute;
  bottom: 0;
  background: var(--color-primary);
  border-radius: 6rpx 6rpx 0 0;
  opacity: 0.85;
  min-height: 6rpx;
}
/* 点中的柱子提亮 + 提到全不透明，与提示条呼应 */
.bar-active {
  opacity: 1;
  background: var(--color-primary);
}
.axis {
  position: relative;
  height: 28rpx;
}
.tick {
  position: absolute;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: var(--color-text-3);
}
.chart-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-3);
}

/* ---------- 分类支出：环图 + 联动比例条 ---------- */
.donut-wrap {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 16rpx;
}
.donut-chart {
  width: 100%;
  height: 340rpx;
}
.cat-list {
  margin-top: 8rpx;
}
.cat-row {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
}
/* 与环图选中扇区联动：点扇区或点条目，两边同时高亮 */
.cat-row-active {
  background: var(--color-fill);
}
.cat-name {
  width: 104rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
}
.cat-row-active .cat-name {
  color: var(--color-text-1);
  font-weight: 600;
}
.cat-track {
  flex: 1;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--color-fill);
  overflow: hidden;
}
.cat-fill {
  height: 100%;
  border-radius: 6rpx;
}
.cat-amount {
  width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

/* ---------- 各车明细 ---------- */
.car-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.car-row:last-child {
  border-bottom: none;
}
.car-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.car-main {
  flex: 1;
  min-width: 0;
}
.car-name {
  font-size: 26rpx;
  color: var(--color-text-1);
}
/* 能量类型徽标：用户问「哪些是混动」时，页面上要能直接看到 */
.car-type {
  display: inline-block;
  margin-left: 10rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: var(--color-fill);
  font-size: 18rpx;
  line-height: 28rpx;
  color: var(--color-text-3);
  vertical-align: 2rpx;
}
.car-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.car-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.car-arrow {
  margin-left: 8rpx;
  font-size: 30rpx;
  color: var(--color-text-3);
}

/* ---------- 空态 ---------- */
.empty-state {
  padding: 160rpx 40rpx;
  text-align: center;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-3);
}

/* 自定义区间的起止日期行 */
.date-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: -8rpx 0 20rpx;
}
.date-sep {
  font-size: 22rpx;
  color: var(--color-text-3);
}