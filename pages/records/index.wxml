<view class="page">
  <!-- Tab -->
  <view class="seg-tabs">
    <view class="seg {{activeTab === 'fuel' ? 'seg-active' : ''}}" data-tab="fuel" hover-class="hover-dim" bindtap="onTabChange">{{recordNoun}}</view>
    <view class="seg {{activeTab === 'maintain' ? 'seg-active' : ''}}" data-tab="maintain" hover-class="hover-dim" bindtap="onTabChange">保养</view>
    <view class="seg {{activeTab === 'repair' ? 'seg-active' : ''}}" data-tab="repair" hover-class="hover-dim" bindtap="onTabChange">维修</view>
    <view class="seg {{activeTab === 'cost' ? 'seg-active' : ''}}" data-tab="cost" hover-class="hover-dim" bindtap="onTabChange">支出</view>
  </view>

  <!-- 加油 -->
  <block wx:if="{{activeTab === 'fuel'}}">
    <view wx:if="{{fuelRecords.length === 0}}" class="empty">暂无{{recordNoun}}记录，返回车辆详情点右下角「＋」记一笔</view>
    <view wx:for="{{fuelRecords}}" wx:key="sourceId" class="record card">
      <view class="record-top">
        <text class="record-date">{{item.dateText}}</text>
        <text class="record-mileage">{{item.mileage}} km</text>
      </view>
      <view class="record-mid">
        <text class="record-calc">{{item.priceText}} {{item.isCharging ? '元/kWh' : '元/L'}} × {{item.volumeText}} {{item.isCharging ? 'kWh' : 'L'}}</text>
        <text class="record-amount">¥ {{item.amountText}}</text>
      </view>
      <view class="record-tags">
        <text wx:if="{{item.isFull}}" class="tag tag-green">{{item.isCharging ? '充满' : '加满'}}</text>
        <text wx:if="{{item.isLowFuel}}" class="tag tag-orange">{{item.isCharging ? '电量低' : '油量低'}}</text>
      </view>
      <view wx:if="{{item.remark}}" class="record-remark">{{item.remark}}</view>
      <view wx:if="{{item.seg}}" class="record-seg">
        <view class="seg-col">
          <view class="seg-value">{{item.seg.consumption}}</view>
          <view class="seg-label">{{item.isCharging ? 'kWh/100km' : 'L/100km'}}</view>
        </view>
        <view class="seg-col">
          <view class="seg-value">{{item.seg.costPerKm}}</view>
          <view class="seg-label">元/km</view>
        </view>
        <view class="seg-col">
          <view class="seg-value">{{item.seg.mileage}}</view>
          <view class="seg-label">里程 km</view>
        </view>
      </view>
      <view class="record-actions">
        <text class="act edit" data-type="fuel" data-id="{{item.sourceId}}" bindtap="onEdit">编辑</text>
        <text class="act delete" data-type="fuel" data-id="{{item.sourceId}}" bindtap="onDelete">删除</text>
      </view>
    </view>
    <view wx:if="{{fuelRecords.length > 0}}" class="load-more">{{hasMore ? '上拉加载更多' : '没有更多了'}}</view>
  </block>

  <!-- 保养 -->
  <block wx:if="{{activeTab === 'maintain'}}">
    <view wx:if="{{maintainRecords.length === 0}}" class="empty">暂无保养记录</view>
    <view wx:for="{{maintainRecords}}" wx:key="sourceId" class="record card">
      <view class="record-top">
        <text class="record-date">{{item.dateText}}</text>
        <text class="record-mileage">{{item.mileage}} km</text>
      </view>
      <view class="record-mid">
        <text class="record-calc">{{item.names}}</text>
        <text class="record-amount">¥ {{item.amountText}}</text>
      </view>
      <view class="record-actions">
        <text class="act edit" data-type="maintain" data-id="{{item.sourceId}}" bindtap="onEdit">编辑</text>
        <text class="act delete" data-type="maintain" data-id="{{item.sourceId}}" bindtap="onDelete">删除</text>
      </view>
    </view>
    <view wx:if="{{maintainRecords.length > 0}}" class="load-more">{{hasMore ? '上拉加载更多' : '没有更多了'}}</view>
  </block>

  <!-- 维修 -->
  <block wx:if="{{activeTab === 'repair'}}">
    <view wx:if="{{repairRecords.length === 0}}" class="empty">暂无维修记录</view>
    <view wx:for="{{repairRecords}}" wx:key="sourceId" class="record card">
      <view class="record-top">
        <text class="record-date">{{item.dateText}}</text>
        <text class="record-mileage">{{item.mileage}} km</text>
      </view>
      <view class="record-mid">
        <text class="record-calc">{{item.content}}</text>
        <text class="record-amount">¥ {{item.amountText}}</text>
      </view>
      <view class="record-actions">
        <text class="act edit" data-type="repair" data-id="{{item.sourceId}}" bindtap="onEdit">编辑</text>
        <text class="act delete" data-type="repair" data-id="{{item.sourceId}}" bindtap="onDelete">删除</text>
      </view>
    </view>
    <view wx:if="{{repairRecords.length > 0}}" class="load-more">{{hasMore ? '上拉加载更多' : '没有更多了'}}</view>
  </block>

  <!-- 支出 -->
  <block wx:if="{{activeTab === 'cost'}}">
    <view wx:if="{{costRecords.length === 0}}" class="empty">暂无支出记录</view>
    <view wx:for="{{costRecords}}" wx:key="sourceId" class="record card">
      <view class="record-top">
        <view class="cost-head">
          <view class="cost-icon">{{item.emoji}}</view>
          <view class="cost-name">{{item.name}}</view>
        </view>
        <view class="cost-amount">¥ {{item.amountText}}</view>
      </view>
      <view class="cost-sub">{{item.dateText}} {{item.remark}}</view>
      <view class="record-actions">
        <text class="act edit" data-type="cost" data-id="{{item.sourceId}}" bindtap="onEdit">编辑</text>
        <text class="act delete" data-type="cost" data-id="{{item.sourceId}}" bindtap="onDelete">删除</text>
      </view>
    </view>
    <view wx:if="{{costRecords.length > 0}}" class="load-more">{{hasMore ? '上拉加载更多' : '没有更多了'}}</view>
  </block>
</view>
