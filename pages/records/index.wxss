.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.seg-tabs {
  display: flex;
  background: #eceef2;
  border-radius: var(--radius-pill);
  padding: 4rpx;
  margin-bottom: 24rpx;
}
.seg {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--color-text-2);
  border-radius: var(--radius-pill);
}
.seg-active {
  background: #fff;
  color: var(--color-primary);
  font-weight: 600;
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-date {
  font-size: 24rpx;
  color: var(--color-text-3);
}
.record-mileage {
  font-size: 26rpx;
  color: var(--color-text-1);
  font-weight: 600;
}
.record-mid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.record-calc {
  font-size: 26rpx;
  color: var(--color-text-2);
  flex: 1;
  margin-right: 16rpx;
}
.record-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.record-tags {
  margin-top: 12rpx;
}
.record-remark {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
  line-height: 1.5;
}
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  margin-right: 12rpx;
}
.tag-green {
  color: var(--color-success);
  background: var(--color-success-bg);
}
.tag-orange {
  color: var(--color-warning);
  background: var(--color-warning-bg);
}
.record-seg {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f1f4;
}
.seg-col {
  flex: 1;
  text-align: center;
}
.seg-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.seg-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-3);
}
.cost-head {
  display: flex;
  align-items: center;
}
.cost-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.cost-name {
  font-size: 28rpx;
  color: var(--color-text-1);
}
.cost-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.cost-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-3);
}
.record-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f1f4;
}
.act {
  font-size: 26rpx;
}
.act.edit {
  color: var(--color-primary);
}
.act.delete {
  color: var(--color-danger);
}
