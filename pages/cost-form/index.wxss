.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}
.group-title {
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
}
.cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.manage-link {
  font-size: 26rpx;
  color: var(--color-primary);
}
.cat-scroll {
  white-space: nowrap;
  padding: 8rpx 0 16rpx;
}
.cat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  padding: 20rpx 0;
  margin-right: 16rpx;
  border-radius: var(--radius-card);
  border: 2rpx solid transparent;
}
.cat-active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}
.cat-emoji {
  font-size: 52rpx;
}
.cat-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f0f1f4;
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  width: 260rpx;
  font-size: 28rpx;
  color: var(--color-text-1);
  flex-shrink: 0;
}
.required {
  color: var(--color-danger);
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.form-value {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--color-text-2);
}
.footer {
  margin-top: 40rpx;
}
.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
}
