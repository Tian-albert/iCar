<view class="page">
  <view class="card">
    <view class="cat-header">
      <view class="group-title">支出类别</view>
      <text class="manage-link" bindtap="onManageCategory">管理 ›</text>
    </view>
    <scroll-view scroll-x class="cat-scroll">
      <view
        wx:for="{{categories}}"
        wx:key="sourceId"
        class="cat-item {{index === selectedIndex ? 'cat-active' : ''}}"
        data-index="{{index}}"
        bindtap="onSelectCategory">
        <view class="cat-emoji">{{item.emoji}}</view>
        <view class="cat-name">{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="card">
    <view class="form-row">
      <view class="form-label">金额 (元) <text class="required">*</text></view>
      <input class="form-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmountInput" />
    </view>
    <view class="form-row">
      <view class="form-label">支出日期</view>
      <picker mode="date" value="{{dateText}}" bindchange="onDateChange">
        <view class="form-value">{{dateText}}</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">备注</view>
      <input class="form-input" placeholder="如 高速路费" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="onSave">保存</button>
  </view>
</view>
