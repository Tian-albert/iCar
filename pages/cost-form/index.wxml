<view class="page">
  <view class="card">
    <view class="cat-header">
      <view class="group-title">支出类别</view>
      <text class="manage-link" hover-class="hover-dim" bindtap="onManageCategory">管理 ›</text>
    </view>
    <!-- 类别全被隐藏或删除时给出明确出口，避免一片空白 -->
    <view wx:if="{{categories.length === 0}}" class="cat-empty">
      <view class="cat-empty-desc">没有可用的支出类别</view>
      <view class="cat-empty-action" hover-class="hover-dim" bindtap="onManageCategory">去类别管理开启或添加 ›</view>
    </view>
    <scroll-view wx:else scroll-x class="cat-scroll">
      <view
        wx:for="{{categories}}"
        wx:key="sourceId"
        class="cat-item {{index === selectedIndex ? 'cat-active' : ''}}"
        data-index="{{index}}"
        hover-class="hover-dim"
        bindtap="onSelectCategory">
        <view class="cat-emoji">{{item.emoji}}</view>
        <view class="cat-name">{{item.name}}</view>
      </view>
    </scroll-view>
    <view wx:if="{{categoryLocked}}" class="cat-locked">原类别已不可用，保存时将保留原类别不变</view>
  </view>

  <view class="card">
    <view class="form-row">
      <view class="form-label">金额 (元) <text class="required">*</text></view>
      <input class="form-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmountInput" />
    </view>
    <view class="form-row">
      <view class="form-label">支出日期</view>
      <picker mode="date" value="{{dateText}}" bindchange="onDateChange">
        <view class="form-value">{{dateText}}</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">备注</view>
      <input class="form-input" placeholder="如 高速路费" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
  </view>

  <view class="footer">
    <button class="btn-primary" disabled="{{categories.length === 0 && !recordId}}" bindtap="onSave">保存</button>
  </view>
</view>
