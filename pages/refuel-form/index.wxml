<view class="page">
  <view class="card">
    <view class="group-title">基本信息</view>
    <view class="form-row">
      <view class="form-label">{{isCharging ? '充电日期' : '加油日期'}}</view>
      <picker mode="date" value="{{dateText}}" bindchange="onDateChange">
        <view class="form-value">{{dateText}}</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">{{isCharging ? '充电时里程 (km)' : '加油时里程 (km)'}} <text class="required">*</text></view>
      <input class="form-input" type="number" value="{{mileages}}" bindinput="onMileageInput" />
    </view>
  </view>

  <view class="card">
    <view class="group-title">{{isCharging ? '电量信息' : '油量信息'}}</view>
    <view class="form-row">
      <view class="form-label">{{isCharging ? '电价 (元/kWh)' : '单价 (元/升)'}} <text class="required">*</text></view>
      <input class="form-input" type="digit" value="{{unitPrice}}" bindinput="onUnitPriceInput" />
    </view>
    <view class="form-row">
      <view class="form-label">{{isCharging ? '充电量 (kWh)' : '加油量 (升)'}} <text class="required">*</text></view>
      <input class="form-input" type="digit" value="{{volume}}" bindinput="onVolumeInput" />
    </view>
    <view wx:if="{{isCharging}}" class="form-row">
      <view class="form-label">充电前电量 (%)</view>
      <input class="form-input" type="number" placeholder="0–100" value="{{chargeBefore}}" bindinput="onChargeBeforeInput" />
    </view>
    <view wx:if="{{isCharging}}" class="form-row">
      <view class="form-label">充电后电量 (%)</view>
      <input class="form-input" type="number" placeholder="0–100" value="{{chargeAfter}}" bindinput="onChargeAfterInput" />
    </view>
    <view class="form-row">
      <view class="form-label">应付金额 (元)</view>
      <view class="form-value readonly">{{shouldPayText}}</view>
    </view>
    <view class="form-row">
      <view class="form-label">实付金额 (元)</view>
      <input class="form-input" type="digit" value="{{actual}}" bindinput="onActualInput" />
    </view>
  </view>

  <view class="card">
    <view class="group-title">{{isCharging ? '充电选项' : '加油选项'}}</view>
    <view class="opt-row">
      <view class="opt-group">
        <view class="opt-label">{{isCharging ? '充满了吗' : '加满了吗'}}</view>
        <view class="seg-control">
          <view hover-class="hover-dim" class="seg-opt {{fullIndex === 0 ? 'seg-opt-active' : ''}}" data-field="full" data-index="0" bindtap="onOptionSelect">{{isCharging ? '充满' : '加满'}}</view>
          <view hover-class="hover-dim" class="seg-opt {{fullIndex === 1 ? 'seg-opt-active' : ''}}" data-field="full" data-index="1" bindtap="onOptionSelect">{{isCharging ? '没充满' : '没加满'}}</view>
        </view>
      </view>
      <view class="opt-group">
        <view class="opt-label">{{isCharging ? '电量低吗' : '油量低吗'}}</view>
        <view class="seg-control">
          <view hover-class="hover-dim" class="seg-opt {{lowIndex === 0 ? 'seg-opt-active' : ''}}" data-field="low" data-index="0" bindtap="onOptionSelect">低</view>
          <view hover-class="hover-dim" class="seg-opt {{lowIndex === 1 ? 'seg-opt-active' : ''}}" data-field="low" data-index="1" bindtap="onOptionSelect">不低</view>
        </view>
      </view>
      <view class="opt-group">
        <view class="opt-label">上次记了吗</view>
        <view class="seg-control">
          <view hover-class="hover-dim" class="seg-opt {{lastIndex === 0 ? 'seg-opt-active' : ''}}" data-field="last" data-index="0" bindtap="onOptionSelect">记了</view>
          <view hover-class="hover-dim" class="seg-opt {{lastIndex === 1 ? 'seg-opt-active' : ''}}" data-field="last" data-index="1" bindtap="onOptionSelect">没记</view>
        </view>
      </view>
    </view>
    <view class="form-row">
      <view class="form-label">备注</view>
      <input class="form-input" placeholder="选填" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="onSave">保存</button>
  </view>
</view>
