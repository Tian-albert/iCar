.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}
.group-title {
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f0f1f4;
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  width: 260rpx;
  font-size: 28rpx;
  color: var(--color-text-1);
  flex-shrink: 0;
}
.required {
  color: var(--color-danger);
}
/* 加油选项：三组两段式开关同排 */
.opt-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 24rpx;
}
.opt-group {
  flex: 1;
  min-width: 0;
}
.opt-label {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
  text-align: center;
}
.seg-control {
  display: flex;
  background: #f2f3f5;
  border-radius: 10rpx;
  padding: 4rpx;
}
.seg-opt {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--color-text-2);
  border-radius: 8rpx;
}
.seg-opt-active {
  background: #fff;
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.08);
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.form-value {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--color-text-2);
}
.form-value.readonly {
  color: var(--color-text-1);
  font-weight: 600;
}
.footer {
  margin-top: 40rpx;
}
.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
}
