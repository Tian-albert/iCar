/* Tab 宿主页：承载三个 tab 的 swiper */
.host {
  height: 100vh;
  overflow: hidden;
}

.host-swiper {
  width: 100%;
  height: 100%;
}

/*
 * swiper-item 内需要能纵向滚动。
 * swiper-item 本身不是滚动容器，内容超出时要用 scroll-view 包裹；
 * 这里给 swiper-item 设 height:100% + overflow hidden，
 * 由内部组件自行管理滚动。
 */
.host-swiper-item {
  height: 100%;
  overflow: hidden;
}
