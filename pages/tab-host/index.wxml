<view class="host" id="tabHostRoot">
  <!-- 三个 tab 的内容放在同一个 swiper 里，横向滑动真正生效 -->
  <swiper
    class="host-swiper"
    current="{{current}}"
    bindchange="onSwiperChange"
    bindtransition="onSwiperTransition"
    bindanimationfinish="onSwiperAnimationFinish">
    <swiper-item class="host-swiper-item">
      <tab-overview wx:if="{{active === 0}}" id="tabOverview" />
    </swiper-item>
    <swiper-item class="host-swiper-item">
      <tab-vehicles wx:if="{{active === 1}}" id="tabVehicles" />
    </swiper-item>
    <swiper-item class="host-swiper-item">
      <tab-profile wx:if="{{active === 2}}" id="tabProfile" />
    </swiper-item>
  </swiper>
</view>
