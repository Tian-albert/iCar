.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}
.group-title {
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
}
.cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.manage-link {
  font-size: 26rpx;
  color: var(--color-primary);
}
.required {
  color: var(--color-danger);
}
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
}
.tag {
  padding: 16rpx 28rpx;
  border-radius: var(--radius-card);
  background: #f2f3f5;
  color: var(--color-text-2);
  text-align: center;
  min-width: 140rpx;
}
.tag-selected {
  background: var(--color-primary-light);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}
.tag-name {
  font-size: 28rpx;
}
.tag-cycle {
  margin-top: 6rpx;
  font-size: 20rpx;
  opacity: 0.7;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f0f1f4;
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  width: 260rpx;
  font-size: 28rpx;
  color: var(--color-text-1);
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.form-value {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--color-text-2);
}
.footer {
  margin-top: 40rpx;
}
.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
}
