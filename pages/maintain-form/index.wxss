.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  margin-bottom: 24rpx;
}
.group-title {
  padding: 24rpx 0 8rpx;
  font-size: 28rpx;
  color: var(--color-text-3);
}
.cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.manage-link {
  font-size: 28rpx;
  color: var(--color-primary);
}
.required {
  color: var(--color-danger);
}
/* 保养项选择：与「支出」类别选择同一套栅格（图标 + 名称 + 点选高亮） */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
}
.cat-item {
  flex: 0 0 auto;
  /* 卡片内宽 638rpx：3 × 196 + 2 × 16 = 620rpx，留 18rpx 余量，避免换行抖动 */
  width: 196rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx 14rpx;
  border-radius: var(--radius-card);
  background: var(--color-bg);
  border: 2rpx solid transparent;
}
.cat-active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}
.cat-icon {
  font-size: 44rpx;
  line-height: 1;
}
/* 自定义图片图标：与 emoji 同尺寸，避免布局跳动 */
.cat-icon-img {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
}
.cat-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-1);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.cat-active .cat-name {
  color: var(--color-primary);
  font-weight: 600;
}
.cat-cycle {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-3);
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  width: 260rpx;
  font-size: 28rpx;
  color: var(--color-text-1);
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.form-value {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--color-text-2);
}
.footer {
  margin-top: 40rpx;
}
.btn-primary {
  background: var(--color-primary);
  color: var(--color-card);
  border-radius: var(--r-pill);
  font-size: 32rpx;
}
