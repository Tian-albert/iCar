<view class="page">
  <view class="card">
    <view class="cat-header">
      <view class="group-title">选择保养项目 <text class="required">*</text></view>
      <text hover-class="hover-dim" class="manage-link" bindtap="onManageMaintain">管理 ›</text>
    </view>
    <!-- 与「支出」的类别选择保持同一套交互：点图标即选中，图标栅格排布 -->
    <view class="cat-grid">
      <view
        hover-class="hover-dim"
        wx:for="{{maintains}}"
        wx:key="sourceId"
        class="cat-item {{item.selected ? 'cat-active' : ''}}"
        data-index="{{index}}"
        bindtap="onToggleMaintain">
        <image wx:if="{{item.isImage}}" class="cat-icon-img" src="{{item.icon}}" mode="aspectFill" />
        <view wx:else class="cat-icon">{{item.emoji}}</view>
        <view class="cat-name">{{item.name}}</view>
        <!-- 周期是独立操作，catchtap 阻止冒泡，避免点一下同时改了选中态 -->
        <view hover-class="hover-dim" class="cat-cycle" data-id="{{item.sourceId}}" catchtap="onEditCycle">{{item.cycleText}} ›</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="group-title">保养信息</view>
    <view class="form-row">
      <view class="form-label">里程 (km) <text class="required">*</text></view>
      <input class="form-input" type="number" value="{{mileages}}" bindinput="onMileageInput" />
    </view>
    <view class="form-row">
      <view class="form-label">保养日期</view>
      <picker mode="date" value="{{dateText}}" bindchange="onDateChange">
        <view class="form-value">{{dateText}}</view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="group-title">支出信息</view>
    <view class="form-row">
      <view class="form-label">支出金额 (元)</view>
      <input class="form-input" type="digit" placeholder="选填，填写后计入支出" value="{{amount}}" bindinput="onAmountInput" />
    </view>
    <view class="form-row">
      <view class="form-label">备注</view>
      <input class="form-input" placeholder="选填" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
  </view>

  <view class="footer">
    <button class="btn-primary" bindtap="onSave">保存</button>
  </view>
</view>
