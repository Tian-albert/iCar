.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}
.empty {
  padding: 200rpx 40rpx;
  text-align: center;
}
.empty-icon {
  font-size: 120rpx;
}
.empty-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
}
.car-card {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.car-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}
.car-info {
  flex: 1;
}
.car-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.car-mileage {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
}
.pin-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 8rpx;
  vertical-align: middle;
}
.car-arrow {
  font-size: 40rpx;
  color: var(--color-text-3);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 0 16rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.manage-link {
  font-size: 26rpx;
  color: var(--color-primary);
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 8rpx 32rpx;
}
.mnt-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}
.mnt-row:last-child {
  border-bottom: none;
}
.mnt-name {
  font-size: 28rpx;
  color: var(--color-text-1);
}
.mnt-remain {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-warning);
  font-weight: 600;
}
.mnt-bar {
  margin-top: 12rpx;
  height: 12rpx;
  background: #eef0f3;
  border-radius: 6rpx;
  overflow: hidden;
}
.mnt-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
}
.empty-card {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-3);
}
