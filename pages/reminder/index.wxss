.page {
  min-height: 100vh;
  padding: 24rpx;
  /* 悬浮胶囊底栏：胶囊高 108rpx + 底部偏移 20rpx + 安全区 + 呼吸留白 */
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- A 全局指标条 ---------- */
.head-line {
  padding: 8rpx 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.metrics {
  display: flex;
  padding: 28rpx 8rpx;
  background: var(--color-card);
  border-radius: var(--radius-card);
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}
.m-cell {
  flex: 1;
  position: relative;
  text-align: center;
}
.m-cell + .m-cell::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: var(--color-divider);
}
.m-val {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.m-val-sm {
  font-size: 32rpx;
}
.m-lbl {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.m-warn .m-val {
  color: var(--color-danger);
}

/* ---------- E 漏记提醒（弱提示） ---------- */
.stale {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 8rpx 0;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.stale-ic {
  opacity: 0.7;
}

/* ---------- 区块 ---------- */
.sec-title {
  margin: 32rpx 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
/* .card 复用 app.wxss 全局类（内边距与阴影已统一，勿在页内重定义） */

/* ---------- B 保养总览 ---------- */
.mnt-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.mnt-row:last-child {
  border-bottom: none;
}
.mnt-car {
  width: 112rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mnt-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mnt-remain {
  flex-shrink: 0;
  font-size: 24rpx;
  white-space: nowrap;
}
.mnt-remain.bad {
  color: var(--color-danger);
  font-weight: 500;
}
.mnt-remain.warn {
  color: var(--color-warning);
}
.go {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
  color: var(--color-text-3);
}
/* 不加 border-top：上一行 .mnt-row 的 border-bottom 已充当分隔线，
   否则两条 1rpx 相邻会叠成 2rpx 的粗线 */
.mnt-all {
  display: block;
  padding-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-primary);
}
.mnt-empty {
  padding: 28rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-3);
}

/* ---------- C 今年花费 · 按车 ---------- */
/* 环图带引出标签，宽度占满卡片，图例移到下方通栏 */
.cost-box {
  display: block;
}
/*
 * 环图逻辑高度 186px（= 372rpx）；实际绘制按 dpr 重设 canvas.width/height。
 * 宽度取 100%：标签要占左右两侧，必须按卡片实际宽度布局。
 */
.donut-canvas {
  display: block;
  width: 100%;
  height: 372rpx;
}
/* 无支出时收起画布（节点保留以便后续绘制），把空间让给空态文案 */
.donut-canvas.donut-idle {
  width: 0;
  height: 0;
  opacity: 0;
}
.cost-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-3);
  line-height: 1.6;
}
.donut-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-3);
  padding: 4rpx 0 12rpx;
}
.legend {
  display: flex;
  flex-direction: column;
}
.lg-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 4rpx;
  border-radius: 10rpx;
}
/* 选中态：与环图扇区高亮呼应 */
.lg-row.lg-on {
  background: var(--color-fill);
}
.lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
/* 车名定宽，各行比例条起点才对齐、长度才可比 */
.lg-name {
  width: 124rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lg-track {
  flex: 1;
  min-width: 0;
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--color-fill);
  overflow: hidden;
}
.lg-bar {
  height: 100%;
  border-radius: 6rpx;
  /* 占比极小时保底可见，否则 1% 的项看起来像没有数据 */
  min-width: 4rpx;
}
/* 金额定宽右对齐：位数不同也不会让比例条长度抖动 */
.lg-val {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-1);
  text-align: right;
}

/* ---------- D 最近记录 ---------- */
.rec-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.rec-row:last-child {
  border-bottom: none;
}
.rec-date {
  width: 84rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.rec-car {
  width: 108rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rec-type {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-1);
}
.rec-amt {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

/* ---------- F 出行成本（两列图块） ---------- */
/* 首个区块标题贴着顶部，别留 32rpx 的上边距 */
.page > .sec-title:first-child {
  margin-top: 4rpx;
}
.cost-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.tile {
  position: relative;
  overflow: hidden;
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 24rpx 24rpx 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}
/* 左侧彩色竖条：颜色即该车在环图里的配色 */
.tile-stripe {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  border-radius: var(--radius-card) 0 0 var(--radius-card);
}
.t-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}
.t-ic {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.t-ic-img {
  width: 26rpx;
  height: 26rpx;
}
.t-ic-emoji {
  font-size: 22rpx;
  line-height: 1;
}
.t-name {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--color-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 服役天数胶囊：右上角、浅灰、比正文小一档 */
.t-days {
  flex-shrink: 0;
  font-size: 18rpx;
  color: var(--color-text-3);
  background: var(--color-fill);
  border-radius: 14rpx;
  padding: 4rpx 10rpx;
  line-height: 1.3;
  white-space: nowrap;
}
.t-main {
  display: flex;
  align-items: baseline;
  margin-bottom: 2rpx;
}
/* 字号由 JS 按两列中的较小值统一注入，这里只定基础值 */
.t-cost {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1;
}
.t-per {
  font-size: 21rpx;
  font-weight: 500;
  color: var(--color-text-3);
  margin-left: 2rpx;
}
/* 上区（每公里成本）与下区（累计数据）之间的分割线 */
.t-divider {
  height: 1px;
  background: var(--color-divider);
  margin: 18rpx 0 16rpx;
}
.t-foot {
  display: flex;
  align-items: flex-start;
}
.t-group {
  flex: 1;
  min-width: 0;
}
.t-v {
  font-weight: 600;
  color: var(--color-text-1);
  line-height: 1.25;
  letter-spacing: -0.2rpx;
  white-space: nowrap;
  overflow: hidden;
}
.t-k {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--color-text-3);
  line-height: 1.2;
}
/* 下区中间的极淡竖线：起分栏作用，比圆点更静、更省宽度 */
.t-vline {
  width: 1px;
  height: 44rpx;
  background: var(--color-divider);
  flex-shrink: 0;
  align-self: center;
  margin: 0 12rpx;
}

/* 数据总览卡：整块可点，右上角小箭头提示「还能进下一层」 */
.metrics-link {
  position: relative;
}
.overview-arrow {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--color-text-3);
}

/* 保养状态环图卡：整卡可点，右上角箭头与「数据总览」卡一致 */
.mnt-card {
  position: relative;
}
.mnt-arrow {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--color-text-3);
}
.mnt-donut {
  width: 100%;
  height: 360rpx;
}
.mnt-legend {
  padding: 0 8rpx;
}
.mnt-legend-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.mnt-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}
.mnt-legend-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-2);
}
.mnt-legend-val {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-3);
}
.mnt-legend-val.bad {
  color: var(--color-danger);
}
.mnt-legend-val.warn {
  color: var(--color-warning);
}
.mnt-more {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--color-line);
  font-size: 24rpx;
  color: var(--color-primary);
}