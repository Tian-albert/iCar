<page-meta page-style="{{pageStyle}}" />
<view class="page">
  <block wx:if="{{hasCar}}">
    <!-- 数据总览：点进「数据总览页」（全车按年/按月汇总） -->
    <view class="sec-title">数据总览</view>
    <view hover-class="hover-dim" class="metrics metrics-link" bindtap="onOpenSummary">
      <!-- 右上角小箭头：暗示整块可点，不改动卡片里的三个指标 -->
      <view class="overview-arrow">›</view>
      <view class="m-cell">
        <view class="m-val">{{carCount}}</view>
        <view class="m-lbl">车辆数</view>
      </view>
      <view class="m-cell">
        <view class="m-val m-val-sm">{{yearTotalText}}</view>
        <view class="m-lbl">本年总支出</view>
      </view>
      <view class="m-cell">
        <view class="m-val m-val-sm">{{totalDrivenText}}</view>
        <view class="m-lbl">总里程 (km)</view>
      </view>
    </view>

    <!-- 漏记提醒（弱提示，不用红色） -->
    <view wx:if="{{stale}}" class="stale">
      <text class="stale-ic">🕒</text>
      <text>{{stale.carName}} 已 {{stale.days}} 天没记账了</text>
    </view>

    <!-- 保养总览：状态环图（整卡可点 → 全车保养页），总开关关闭时整块隐藏 -->
    <block wx:if="{{remindEnabled}}">
      <view class="sec-title">保养提醒{{pendingCount > 0 ? ' · ' + pendingCount + ' 项待保养' : ''}}</view>
      <view hover-class="hover-dim" class="card mnt-card" bindtap="onOpenMaintainAll">
        <!-- 整卡可点，右上角箭头与「数据总览」卡一致 -->
        <view class="mnt-arrow">›</view>
        <block wx:if="{{mntTotal > 0}}">
          <!-- 环图在左、图例在右；小尺寸关闭外标签（图例即为标签），否则标签会把环挤没 -->
          <view class="mnt-hero">
            <donut-chart
              class="mnt-donut"
              segments="{{mntSegments}}"
              total="{{mntTotalText}}"
              showLabels="{{false}}"
            />
            <view class="mnt-legend">
              <view class="mnt-legend-row">
                <view class="mnt-dot" style="background:#F5474F"></view>
                <text class="mnt-legend-name">已超期</text>
                <text class="mnt-legend-val bad">{{mntBad}} 项</text>
              </view>
              <view class="mnt-legend-row">
                <view class="mnt-dot" style="background:#E8912A"></view>
                <text class="mnt-legend-name">临近到期</text>
                <text class="mnt-legend-val warn">{{mntWarn}} 项</text>
              </view>
              <view class="mnt-legend-row">
                <view class="mnt-dot" style="background:#B6BCC8"></view>
                <text class="mnt-legend-name">正常</text>
                <text class="mnt-legend-val">{{mntOk}} 项</text>
              </view>
            </view>
          </view>
        </block>
        <view wx:else class="mnt-empty">所有保养项都在周期内</view>
        <view class="mnt-more">更多保养项 ›</view>
      </view>
    </block>

    <!-- 今年花费 · 按车 -->
    <view class="sec-title">今年花费 · 按车</view>
    <view class="card">
      <view class="cost-box">
        <!--
          环图带引出标签，宽度占满卡片；无支出时收起画布但不卸载：
          节点保留，数据回来后仍可直接绘制。
        -->
        <canvas
          type="2d"
          id="overviewDonut"
          class="donut-canvas {{hasYearCost ? '' : 'donut-idle'}}"
          bindtap="onTapDonut"></canvas>

        <block wx:if="{{hasYearCost}}">
          <view class="donut-hint">点扇区或标签可查看该车详情</view>
          <view class="legend">
            <view
              wx:for="{{carCosts}}"
              wx:key="carSourceId"
              class="lg-row {{donutActive === index ? 'lg-on' : ''}}"
              data-index="{{index}}"
              bindtap="onTapLegend">
              <view class="lg-dot" style="background: {{item.color}};"></view>
              <text class="lg-name">{{item.carName}}</text>
              <view class="lg-track">
                <view class="lg-bar" style="width: {{item.percent}}%; background: {{item.color}};"></view>
              </view>
              <text class="lg-val">¥{{item.amountText}}</text>
            </view>
          </view>
        </block>
        <view wx:else class="cost-empty">今年还没有支出记录，记一笔后即可查看各车花费占比</view>
      </view>
    </view>

    <!-- 最近记录（跨车流水，3 条） -->
    <view class="sec-title">最近记录</view>
    <view class="card">
      <view wx:if="{{recent.length === 0}}" class="mnt-empty">还没有记录，去「车辆」页记一笔</view>
      <view
        wx:for="{{recent}}"
        wx:key="key"
        class="rec-row"
        hover-class="hover-dim"
        data-car="{{item.carSourceId}}"
        data-section="{{item.section}}"
        bindtap="onTapRecord">
        <text class="rec-date">{{item.dateText}}</text>
        <text class="rec-car">{{item.carName}}</text>
        <text class="rec-type">{{item.typeLabel}}</text>
        <text class="rec-amt">¥{{item.amountText}}</text>
        <text class="go">›</text>
      </view>
    </view>

    <!-- 出行成本（两列图块） -->
    <view class="sec-title">出行成本</view>
    <view class="cost-grid">
      <view wx:for="{{drivingCosts}}" wx:key="carSourceId" class="tile">
        <view class="tile-stripe" style="background: {{item.color}};"></view>
        <view class="t-head">
          <view class="t-ic" style="background: {{item.iconBg}};">
            <image wx:if="{{item.isImage}}" class="t-ic-img" src="{{item.icon}}" mode="aspectFit" />
            <text wx:else class="t-ic-emoji">{{item.emoji}}</text>
          </view>
          <text class="t-name">{{item.carName}}</text>
          <text class="t-days">服役{{item.daysText}}天</text>
        </view>
        <view class="t-main">
          <text class="t-cost" style="color: {{item.color}};">{{item.perKmText}}</text>
          <text class="t-per">/km</text>
        </view>
        <view class="t-divider"></view>
        <view class="t-foot">
          <view class="t-group">
            <view class="t-v" style="font-size: {{item.fontText}}px;">{{item.spendText}}</view>
            <view class="t-k">总花费</view>
          </view>
          <view class="t-vline"></view>
          <view class="t-group">
            <view class="t-v" style="font-size: {{item.fontText}}px;">{{item.kmText}}</view>
            <view class="t-k">总里程</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 空态 -->
  <view wx:else class="empty-state">
    <view class="empty-state-icon">🚗</view>
    <view class="empty-state-title">还没有车辆</view>
    <view class="empty-state-desc">先添加你的爱车，开始记录加油、保养与支出</view>
    <view class="empty-state-action" hover-class="hover-dim" bindtap="onAddCar">＋ 添加车辆</view>
  </view>
</view>
