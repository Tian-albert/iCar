<view class="page">
  <!-- 车辆头部 -->
  <view class="header card">
    <view class="header-car">🚙</view>
    <view class="header-info">
      <view class="header-name">{{carName}}</view>
      <view class="header-mileage">当前里程 {{mileages}} km</view>
    </view>
    <view class="header-records" hover-class="header-records-hover" bindtap="onOpenRecords">记录 ›</view>
  </view>

  <!-- 油耗统计卡（点击进入统计看板） -->
  <view class="stat-card" bindtap="onOpenStatistics">
    <view class="stat-arrow">›</view>
    <view class="stat-col">
      <view class="stat-value">{{avgText}}</view>
      <view class="stat-label">平均油耗 L/100km</view>
    </view>
    <view class="stat-col">
      <view class="stat-value">{{costPerKmText}}</view>
      <view class="stat-label">元/公里</view>
    </view>
    <view class="stat-col">
      <view class="stat-value">{{totalMileageText}}</view>
      <view class="stat-label">
        有效里程 km
        <text class="help-icon" catchtap="onExplainMileage">?</text>
      </view>
    </view>
  </view>

  <!-- 近期支出 -->
  <view class="section-title">近期支出</view>
  <view class="card cost-card" wx:if="{{recentCosts.length > 0}}">
    <view wx:for="{{recentCosts}}" wx:key="sourceId" class="cost-row">
      <view class="cost-icon">{{item.emoji}}</view>
      <view class="cost-main">
        <view class="cost-name">{{item.name}}</view>
        <view class="cost-sub">{{item.dateText}} {{item.remark}}</view>
      </view>
      <view class="cost-amount">¥ {{item.amountText}}</view>
    </view>
  </view>
  <view wx:else class="empty">暂无支出记录</view>

  <!-- 保养进度（只显示快要保养的项目） -->
  <view class="section-header">
    <view class="section-title">保养进度</view>
    <view class="header-actions">
      <text class="manage-link" bindtap="onManageThreshold">设置</text>
      <text class="manage-link" bindtap="onManageMaintain">更多 ›</text>
    </view>
  </view>
  <view class="card" wx:if="{{maintainProgress.length > 0}}">
    <view wx:for="{{maintainProgress}}" wx:key="name" class="mnt-row">
      <view class="mnt-name">{{item.name}}</view>
      <view class="mnt-remain {{item.urgent ? 'mnt-urgent' : ''}}">{{item.remainText}}</view>
      <view class="mnt-bar">
        <view class="mnt-bar-fill" style="width: {{item.progressPercent}}%;"></view>
      </view>
    </view>
  </view>
  <view wx:else class="empty" bindtap="onManageMaintain">暂无快到期的保养项目，点此查看全部 ›</view>

  <!-- 记录列表 -->
  <view class="section-title">加油记录</view>
  <view wx:if="{{records.length === 0}}" class="empty">还没有加油记录，点下方按钮记一笔</view>

  <view wx:for="{{records}}" wx:key="sourceId" class="record card">
    <view class="record-top">
      <text class="record-date">{{item.dateText}}</text>
      <text class="record-mileage">{{item.mileage}} km</text>
    </view>
    <view class="record-mid">
      <text class="record-calc">{{item.priceText}} 元/L × {{item.volumeText}} L</text>
      <text class="record-amount">¥ {{item.amountText}}</text>
    </view>
    <view class="record-tags">
      <text wx:if="{{item.isFull}}" class="tag tag-green">加满</text>
      <text wx:if="{{item.isLowFuel}}" class="tag tag-orange">油量低</text>
    </view>
    <view wx:if="{{item.seg}}" class="record-seg">
      <view class="seg-col">
        <view class="seg-value">{{item.seg.consumption}}</view>
        <view class="seg-label">L/100km</view>
      </view>
      <view class="seg-col">
        <view class="seg-value">{{item.seg.costPerKm}}</view>
        <view class="seg-label">元/km</view>
      </view>
      <view class="seg-col">
        <view class="seg-value">{{item.seg.mileage}}</view>
        <view class="seg-label">里程 km</view>
      </view>
    </view>
  </view>

  <view class="footer-actions">
    <button class="btn-primary" bindtap="onAddRefuel">＋ 加油</button>
    <button class="btn-secondary" bindtap="onAddMaintain">＋ 保养</button>
    <button class="btn-secondary" bindtap="onAddCost">＋ 支出</button>
    <button class="btn-secondary" bindtap="onAddRepair">＋ 维修</button>
  </view>
</view>
