.page {
  min-height: 100vh;
  padding: 24rpx;
  /* 给右下角悬浮按钮留出空间，避免遮挡最后一条记录 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx 32rpx;
}
.header {
  display: flex;
  align-items: center;
}
.header-car {
  font-size: 72rpx;
  margin-right: 24rpx;
}
.header-info {
  flex: 1;
}
.header-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.header-mileage {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
}
.header-records {
  font-size: 26rpx;
  color: var(--color-primary);
  flex-shrink: 0;
  padding: 16rpx 0 16rpx 32rpx;
}
.header-records-hover {
  opacity: 0.6;
}
.latest-card {
  margin-top: 24rpx;
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 28rpx 32rpx;
}
.latest-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.latest-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.latest-sub {
  font-size: 22rpx;
  color: var(--color-text-3);
}
.latest-body {
  display: flex;
  margin-top: 20rpx;
}
.latest-col {
  flex: 1;
  text-align: center;
}
.latest-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.latest-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.stat-card {
  position: relative;
  display: flex;
  margin-top: 24rpx;
  background: var(--color-dark-card);
  border-radius: var(--radius-card);
  padding: 32rpx 0;
}
.stat-arrow {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  color: #8a93a6;
  font-size: 40rpx;
  line-height: 1;
}
.stat-col {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
}
.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a93a6;
}
.help-icon {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  line-height: 22rpx;
  text-align: center;
  margin-left: 6rpx;
  border: 1rpx solid #8a93a6;
  border-radius: 50%;
  color: #8a93a6;
  font-size: 18rpx;
  vertical-align: middle;
}
.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-3);
}
.record {
  margin-bottom: 20rpx;
}
.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.record-date {
  font-size: 24rpx;
  color: var(--color-text-3);
}
.record-mileage {
  font-size: 26rpx;
  color: var(--color-text-1);
  font-weight: 600;
}
.record-mid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.record-calc {
  font-size: 26rpx;
  color: var(--color-text-2);
}
.record-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.record-tags {
  margin-top: 12rpx;
}
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  margin-right: 12rpx;
}
.tag-green {
  color: var(--color-success);
  background: var(--color-success-bg);
}
.tag-orange {
  color: var(--color-warning);
  background: var(--color-warning-bg);
}
.record-seg {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f1f4;
}
.seg-col {
  flex: 1;
  text-align: center;
}
.seg-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.seg-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--color-text-3);
}
.cost-card {
  padding: 8rpx 32rpx;
}
.cost-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0f1f4;
}
.cost-row:last-child {
  border-bottom: none;
}
.cost-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}
.cost-main {
  flex: 1;
}
.cost-name {
  font-size: 28rpx;
  color: var(--color-text-1);
}
.cost-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-3);
}
.cost-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 32rpx 0 16rpx;
}
.section-header .section-title {
  margin: 0;
}
.header-actions {
  display: flex;
  gap: 24rpx;
}
.manage-link {
  font-size: 26rpx;
  color: var(--color-primary);
}
.mnt-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}
.mnt-row:last-child {
  border-bottom: none;
}
.mnt-name {
  font-size: 28rpx;
  color: var(--color-text-1);
}
.mnt-remain {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.mnt-remain.mnt-urgent {
  color: var(--color-warning);
  font-weight: 600;
}
.mnt-bar {
  margin-top: 12rpx;
  height: 12rpx;
  background: #eef0f3;
  border-radius: 6rpx;
  overflow: hidden;
}
.mnt-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: 6rpx;
}
/* 查看全部记录入口 */
.more-row {
  margin-top: 8rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-primary);
}
/* 右下角悬浮「记一笔」 */
.fab-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.06);
}
.fab-wrap {
  position: fixed;
  right: 32rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.fab-menu {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.fab-item {
  padding: 18rpx 40rpx;
  background: #fff;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  color: var(--color-text-1);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
}
.fab {
  width: 112rpx;
  height: 112rpx;
  line-height: 108rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 56rpx;
  box-shadow: 0 10rpx 28rpx rgba(59, 111, 246, 0.4);
  transition: transform 0.2s ease;
}
.fab.fab-active {
  transform: rotate(45deg);
}
.record-remark {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
  line-height: 1.5;
}
