.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: 8rpx 32rpx;
}
.form-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 1rpx solid #f0f1f4;
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  width: 320rpx;
  font-size: 28rpx;
  color: var(--color-text-1);
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.tip {
  margin: 24rpx 8rpx;
  font-size: 24rpx;
  color: var(--color-text-3);
}
.footer {
  margin-top: 40rpx;
}
.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
}
