{
  "apis": [
    {
      "name": "queryCars",
      "_meta": {
        "ui": {
          "pagePath": "pages/summary/index"
        }
      },
      "description": "列出用户已有的车辆及每辆车的能量类型（燃油/纯电/混动）、当前里程、是否置顶。适用于「我有几辆车」「我的车叫什么」；多车用户要记账或查统计前，可先用它确认车名再传 carName。只读。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "string"
          },
          "items": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "queryStats",
      "_meta": {
        "ui": {
          "pagePath": "pages/summary/index"
        }
      },
      "description": "查询养车花费与能耗统计。**用户没说哪辆车且有多辆车时，返回全部车辆合计与每车明细**（「今年养车花了多少」问的是全部，不是某一辆）；说了车名则只返回那一辆。含总支出、每公里成本、油耗/电耗、有效里程。只读。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string",
            "description": "车辆名称，如「我的 CRV」。用户明确说了哪辆车才传；没说就留空，由接口决定是单车还是全车合计"
          },
          "rangeType": {
            "type": "string",
            "enum": [
              "year",
              "month",
              "all",
              "custom"
            ],
            "description": "统计维度：year 今年（默认）、month 本月、all 全部时间、custom 自定义区间（配合 startDate/endDate，用于「最近半个月」「国庆那几天」）"
          },
          "year": {
            "type": "number",
            "description": "指定年份，如 2026。不传则取当前年份"
          },
          "month": {
            "type": "number",
            "description": "指定月份 1-12，仅在 rangeType 为 month 时有效"
          },
          "startDate": {
            "type": "string",
            "description": "自定义区间起点，格式 YYYY-MM-DD。用户说「最近半个月」「国庆那几天」时，把口语换算成具体日期传进来"
          },
          "endDate": {
            "type": "string",
            "description": "自定义区间终点，格式 YYYY-MM-DD，含当天。与 startDate 同时使用"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "energyType": {
            "type": "string"
          },
          "rangeLabel": {
            "type": "string"
          },
          "totalExpense": {
            "type": "string"
          },
          "perKm": {
            "type": "string"
          },
          "perKmExFuel": {
            "type": "string"
          },
          "energyCost": {
            "type": "string"
          },
          "energyCostLabel": {
            "type": "string"
          },
          "avgConsumption": {
            "type": "string"
          },
          "consumptionUnit": {
            "type": "string"
          },
          "consumptionMileage": {
            "type": "string"
          },
          "mileageIncreased": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "percent": {
                  "type": "string"
                }
              }
            }
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "queryMaintain",
      "_meta": {
        "ui": {
          "pagePath": "pages/maintain-all/index"
        }
      },
      "description": "查询保养项剩余里程与剩余天数。**用户没说哪辆车且有多辆车时，汇总所有车辆的待保养项**（「有几项要保养」问的是全部）；说了车名则只查那一辆。默认只返回已超期或临近到期的项。只读。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string",
            "description": "车辆名称。用户明确说了哪辆车才传；没说就留空"
          },
          "onlyUrgent": {
            "type": "boolean",
            "description": "是否只返回超期/临近的项，默认 true。用户问「所有保养项」时传 false"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "energyType": {
            "type": "string"
          },
          "overdueCount": {
            "type": "string"
          },
          "urgentCount": {
            "type": "string"
          },
          "items": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "addCost",
      "_meta": {
        "ui": {
          "pagePath": "pages/vehicle-detail/index"
        }
      },
      "description": "帮用户记一笔支出并写入本地存储，例如「记一笔停车费 15 块」「昨天高速费 80」。金额必填且必须大于 0；缺少金额时不要调用本接口，先向用户追问。写入成功前不要告诉用户已经记好。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "金额，单位元，必须大于 0。用户说的「十五块」要转成 15"
          },
          "categoryName": {
            "type": "string",
            "description": "支出类别名，如 停车 / 高速 / 保险 / 洗车。不确定时不要编造，省略即可"
          },
          "carName": {
            "type": "string",
            "description": "车辆名称。**用户有多辆车又没说哪辆时不要传**：请先问用户记到哪辆车再调用，不要传这个参数"
          },
          "dateText": {
            "type": "string",
            "description": "发生日期，格式 YYYY-MM-DD。用户说「昨天」时换算成具体日期；不传默认今天"
          },
          "remark": {
            "type": "string",
            "description": "备注，如「机场停车」。可省略"
          }
        },
        "required": [
          "amount"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "categoryName": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "dateText": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "addRefuel",
      "_meta": {
        "ui": {
          "pagePath": "pages/vehicle-detail/index"
        }
      },
      "description": "帮用户记一笔加油或充电并写入本地存储。加油量（升/度）必填；单价与实付金额给一个即可，另一个会自动反算。加满两次后才能算出油耗，因此 isFull 要如实传。缺少加油量或金额时不要调用，先追问。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "volume": {
            "type": "number",
            "description": "加油量（升）或充电量（kWh），必须大于 0。用户说「加了 40 个」即 40"
          },
          "unitPrice": {
            "type": "number",
            "description": "单价（元/升 或 元/kWh）。与 amount 至少给一个"
          },
          "amount": {
            "type": "number",
            "description": "实付金额（元）。与 unitPrice 至少给一个；都给了以 amount 为准"
          },
          "mileage": {
            "type": "number",
            "description": "加油/充电时的总里程 km。用户没说时不传，会沿用车辆当前里程（回复里会提示可能不准）"
          },
          "carName": {
            "type": "string",
            "description": "车辆名称。**用户有多辆车又没说哪辆时不要传**：请先问用户是哪辆车再调用，不要传这个参数"
          },
          "isFull": {
            "type": "boolean",
            "description": "这次是否加满/充满，默认 true。没加满时油耗要等下次加满才算得出"
          },
          "isLowFuel": {
            "type": "boolean",
            "description": "加油前油量/电量是否已偏低，默认 false"
          },
          "dateText": {
            "type": "string",
            "description": "加油日期 YYYY-MM-DD，默认今天"
          },
          "remark": {
            "type": "string",
            "description": "备注，如「中石化 92 号」。可省略"
          },
          "energyType": {
            "type": "string",
            "enum": [
              "fuel",
              "ev"
            ],
            "description": "能量类型：用户说「加油」传 fuel，「充电」传 ev。混动车两种都会记，不说则按车辆类型推断"
          }
        },
        "required": [
          "volume"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "energyType": {
            "type": "string"
          },
          "kindLabel": {
            "type": "string"
          },
          "volume": {
            "type": "string"
          },
          "volumeUnit": {
            "type": "string"
          },
          "unitPrice": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "mileage": {
            "type": "string"
          },
          "dateText": {
            "type": "string"
          },
          "consumption": {
            "type": "string"
          },
          "consumptionUnit": {
            "type": "string"
          },
          "consumptionMileage": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "addMaintain",
      "description": "记录一次保养并重置该项的周期。必须先知道**哪辆车**与**哪一项保养**（如机油机滤）：保养项不存在时不要凭空创建，引导用户到「保养项管理」添加。金额选填，传了会同时记一笔保养支出。",
      "_meta": {
        "ui": {
          "pagePath": "pages/vehicle-detail/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "maintainName": {
            "type": "string",
            "description": "保养项名称，如「机油机滤」「空气滤芯」。必须是这辆车已配置的项"
          },
          "carName": {
            "type": "string",
            "description": "车辆名称。**用户有多辆车又没说哪辆时不要传**：先问用户是哪辆车再调用"
          },
          "mileage": {
            "type": "number",
            "description": "保养时的总里程 km。用户没说就留空，沿用车辆当前里程"
          },
          "amount": {
            "type": "number",
            "description": "本次保养花费（元）。用户没说就不传，不会记 0 元支出"
          },
          "dateText": {
            "type": "string",
            "description": "保养日期 YYYY-MM-DD，默认今天"
          },
          "remark": {
            "type": "string",
            "description": "备注，如「4S 店」。可省略"
          }
        },
        "required": [
          "maintainName"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "maintainName": {
            "type": "string"
          },
          "mileage": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "remainText": {
            "type": "string"
          },
          "cycleText": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "addCar",
      "description": "新增一辆车。用户说「我有一辆 CRV」「帮我加一辆纯电车」时用。车辆是全部统计的基础，没有车什么都查不了。只做最小必填：名称 + 能量类型，里程没说不编。",
      "_meta": {
        "ui": {
          "pagePath": "pages/vehicle-detail/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "车辆名称，如「我的 CRV」。必填"
          },
          "energyType": {
            "type": "string",
            "enum": [
              "fuel",
              "ev",
              "hybrid"
            ],
            "description": "能量类型：fuel 燃油（默认）、ev 纯电、hybrid 混动"
          },
          "mileages": {
            "type": "number",
            "description": "当前总里程 km。用户没说就不传，会按 0 记"
          },
          "batteryCapacity": {
            "type": "number",
            "description": "电池容量 kWh，纯电或混动可传"
          }
        },
        "required": [
          "name"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "energyType": {
            "type": "string"
          },
          "mileages": {
            "type": "string"
          },
          "carCount": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "updateCar",
      "description": "修改已有车辆的信息：改名、改能量类型、改当前里程、改电池容量。必须先确定是哪辆车；改名要做重名校验。用户没说改什么时不要调用，先问。",
      "_meta": {
        "ui": {
          "pagePath": "pages/vehicle-detail/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string",
            "description": "要修改哪辆车（现有名称）。用户有多辆车又没说时不要传，先问"
          },
          "newName": {
            "type": "string",
            "description": "改名后的新名称。不改名就不传"
          },
          "energyType": {
            "type": "string",
            "enum": [
              "fuel",
              "ev",
              "hybrid"
            ],
            "description": "新的能量类型。不改就不传"
          },
          "mileages": {
            "type": "number",
            "description": "新的当前总里程 km。不改就不传"
          },
          "batteryCapacity": {
            "type": "number",
            "description": "新的电池容量 kWh。不改就不传"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "energyType": {
            "type": "string"
          },
          "mileages": {
            "type": "string"
          },
          "batteryCapacity": {
            "type": "string"
          },
          "changed": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "queryRecords",
      "description": "查某辆车的用车记录（近期明细）：默认返回最近 10 条，含日期、类型、摘要与金额，并给出合计。用户问「我最近记过什么」「上个月都花了哪些」时用。只读。",
      "_meta": {
        "ui": {
          "pagePath": "pages/records/index"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string",
            "description": "车辆名称。多辆车又没说时不要传，先问用户"
          },
          "type": {
            "type": "string",
            "enum": [
              "all",
              "cost",
              "fuel",
              "maintain",
              "repair"
            ],
            "description": "只看某一类记录：all 全部（默认）、cost 日常支出、fuel 加油充电、maintain 保养、repair 维修"
          },
          "rangeType": {
            "type": "string",
            "enum": [
              "year",
              "month",
              "all",
              "custom"
            ],
            "description": "时间范围：all 全部（默认）、year 今年、month 本月、custom 任意区间"
          },
          "year": {
            "type": "number",
            "description": "年份，如 2026"
          },
          "month": {
            "type": "number",
            "description": "月份 1-12，仅在 rangeType 为 month 时使用"
          },
          "startDate": {
            "type": "string",
            "description": "任意区间起点 YYYY-MM-DD"
          },
          "endDate": {
            "type": "string",
            "description": "任意区间终点 YYYY-MM-DD，含当天"
          },
          "limit": {
            "type": "number",
            "description": "最多返回几条，默认 10，上限 30"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "rangeLabel": {
            "type": "string"
          },
          "count": {
            "type": "string"
          },
          "totalExpense": {
            "type": "string"
          },
          "items": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    }
  ]
}
