{
  "apis": [
    {
      "name": "queryCars",
      "_meta": {
        "ui": {
          "pagePath": "pages/summary/index"
        }
      },
      "description": "列出用户已有的车辆及每辆车的能量类型（燃油/纯电/混动）、当前里程、是否置顶。适用于「我有几辆车」「我的车叫什么」；多车用户要记账或查统计前，可先用它确认车名再传 carName。只读。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "string"
          },
          "items": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "queryStats",
      "_meta": {
        "ui": {
          "pagePath": "pages/summary/index"
        }
      },
      "description": "查询养车花费与能耗统计。**用户没说哪辆车且有多辆车时，返回全部车辆合计与每车明细**（「今年养车花了多少」问的是全部，不是某一辆）；说了车名则只返回那一辆。含总支出、每公里成本、油耗/电耗、有效里程。只读。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string",
            "description": "车辆名称，如「我的 CRV」。用户明确说了哪辆车才传；没说就留空，由接口决定是单车还是全车合计"
          },
          "rangeType": {
            "type": "string",
            "enum": [
              "year",
              "month",
              "all",
              "custom"
            ],
            "description": "统计维度：year 今年（默认）、month 本月、all 全部时间、custom 自定义区间（配合 startDate/endDate，用于「最近半个月」「国庆那几天」）"
          },
          "year": {
            "type": "number",
            "description": "指定年份，如 2026。不传则取当前年份"
          },
          "month": {
            "type": "number",
            "description": "指定月份 1-12，仅在 rangeType 为 month 时有效"
          },
          "startDate": {
            "type": "string",
            "description": "自定义区间起点，格式 YYYY-MM-DD。用户说「最近半个月」「国庆那几天」时，把口语换算成具体日期传进来"
          },
          "endDate": {
            "type": "string",
            "description": "自定义区间终点，格式 YYYY-MM-DD，含当天。与 startDate 同时使用"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "energyType": {
            "type": "string"
          },
          "rangeLabel": {
            "type": "string"
          },
          "totalExpense": {
            "type": "string"
          },
          "perKm": {
            "type": "string"
          },
          "perKmExFuel": {
            "type": "string"
          },
          "energyCost": {
            "type": "string"
          },
          "energyCostLabel": {
            "type": "string"
          },
          "avgConsumption": {
            "type": "string"
          },
          "consumptionUnit": {
            "type": "string"
          },
          "consumptionMileage": {
            "type": "string"
          },
          "mileageIncreased": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "percent": {
                  "type": "string"
                }
              }
            }
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "queryMaintain",
      "_meta": {
        "ui": {
          "pagePath": "pages/maintain-all/index"
        }
      },
      "description": "查询保养项剩余里程与剩余天数。**用户没说哪辆车且有多辆车时，汇总所有车辆的待保养项**（「有几项要保养」问的是全部）；说了车名则只查那一辆。默认只返回已超期或临近到期的项。只读。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string",
            "description": "车辆名称。用户明确说了哪辆车才传；没说就留空"
          },
          "onlyUrgent": {
            "type": "boolean",
            "description": "是否只返回超期/临近的项，默认 true。用户问「所有保养项」时传 false"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "energyType": {
            "type": "string"
          },
          "overdueCount": {
            "type": "string"
          },
          "urgentCount": {
            "type": "string"
          },
          "items": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "addCost",
      "_meta": {
        "ui": {
          "pagePath": "pages/vehicle-detail/index"
        }
      },
      "description": "帮用户记一笔支出并写入本地存储，例如「记一笔停车费 15 块」「昨天高速费 80」。金额必填且必须大于 0；缺少金额时不要调用本接口，先向用户追问。写入成功前不要告诉用户已经记好。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "金额，单位元，必须大于 0。用户说的「十五块」要转成 15"
          },
          "categoryName": {
            "type": "string",
            "description": "支出类别名，如 停车 / 高速 / 保险 / 洗车。不确定时不要编造，省略即可"
          },
          "carName": {
            "type": "string",
            "description": "车辆名称。**用户有多辆车又没说哪辆时不要传**：请先问用户记到哪辆车再调用，不要传这个参数"
          },
          "dateText": {
            "type": "string",
            "description": "发生日期，格式 YYYY-MM-DD。用户说「昨天」时换算成具体日期；不传默认今天"
          },
          "remark": {
            "type": "string",
            "description": "备注，如「机场停车」。可省略"
          }
        },
        "required": [
          "amount"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "categoryName": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "dateText": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    },
    {
      "name": "addRefuel",
      "_meta": {
        "ui": {
          "pagePath": "pages/vehicle-detail/index"
        }
      },
      "description": "帮用户记一笔加油或充电并写入本地存储。加油量（升/度）必填；单价与实付金额给一个即可，另一个会自动反算。加满两次后才能算出油耗，因此 isFull 要如实传。缺少加油量或金额时不要调用，先追问。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "volume": {
            "type": "number",
            "description": "加油量（升）或充电量（kWh），必须大于 0。用户说「加了 40 个」即 40"
          },
          "unitPrice": {
            "type": "number",
            "description": "单价（元/升 或 元/kWh）。与 amount 至少给一个"
          },
          "amount": {
            "type": "number",
            "description": "实付金额（元）。与 unitPrice 至少给一个；都给了以 amount 为准"
          },
          "mileage": {
            "type": "number",
            "description": "加油/充电时的总里程 km。用户没说时不传，会沿用车辆当前里程（回复里会提示可能不准）"
          },
          "carName": {
            "type": "string",
            "description": "车辆名称。**用户有多辆车又没说哪辆时不要传**：请先问用户是哪辆车再调用，不要传这个参数"
          },
          "isFull": {
            "type": "boolean",
            "description": "这次是否加满/充满，默认 true。没加满时油耗要等下次加满才算得出"
          },
          "isLowFuel": {
            "type": "boolean",
            "description": "加油前油量/电量是否已偏低，默认 false"
          },
          "dateText": {
            "type": "string",
            "description": "加油日期 YYYY-MM-DD，默认今天"
          },
          "remark": {
            "type": "string",
            "description": "备注，如「中石化 92 号」。可省略"
          },
          "energyType": {
            "type": "string",
            "enum": [
              "fuel",
              "ev"
            ],
            "description": "能量类型：用户说「加油」传 fuel，「充电」传 ev。混动车两种都会记，不说则按车辆类型推断"
          }
        },
        "required": [
          "volume"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carName": {
            "type": "string"
          },
          "energyType": {
            "type": "string"
          },
          "kindLabel": {
            "type": "string"
          },
          "volume": {
            "type": "string"
          },
          "volumeUnit": {
            "type": "string"
          },
          "unitPrice": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "mileage": {
            "type": "string"
          },
          "dateText": {
            "type": "string"
          },
          "consumption": {
            "type": "string"
          },
          "consumptionUnit": {
            "type": "string"
          },
          "consumptionMileage": {
            "type": "string"
          },
          "linkText": {
            "type": "string"
          },
          "pagePath": {
            "type": "string",
            "format": "page-link",
            "x-link-text-field": "linkText"
          }
        }
      }
    }
  ]
}
